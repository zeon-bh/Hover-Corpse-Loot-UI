    <!-- Sub-Tab 2: Quick-Loot & Controls -->
    <string id="ui_mcm_hover_corpse_loot_hcl_loot_ql_enabled">
        <text>Enable Mouse-Wheel Quick-Looting</text>
    </string>
    <string id="ui_mcm_hover_corpse_loot_hcl_loot_ql_enabled_desc">
        <text>Allows scrolling the mouse wheel while hovering over a corpse to highlight and loot items directly.\n- Left Click (Release): Loot Selected Item\n- Right Click (Release): Loot All Items\n- Hold Left Click + Scroll: Sweep-Loot Row\n- Hold Right Click + Scroll: Sweep-Disassemble Row (if enabled)</text>
    </string>
