    <!-- Row Sorting & 2D Scroll Navigation Strings -->
    <string id="ui_mcm_hover_corpse_loot_hcl_ui_sort_mode">
        <text>Item Sorting &amp; Row Grouping Mode</text>
    </string>
    <string id="ui_mcm_lst_hcl_sort_classic">
        <text>Classic (Pack by Item Size)</text>
    </string>
    <string id="ui_mcm_lst_hcl_sort_macro">
