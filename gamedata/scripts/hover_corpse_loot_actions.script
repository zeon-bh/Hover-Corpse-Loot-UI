---------------------------------------------------------------------------------------
-- Loads and caches `sortingplus.ltx` and the user's `SortingPlus` MCM category numbers
-- using the exact same rules as `zzz_rax_sortingplus_mcm.script`.
-- Arguments: force_reload (boolean) - Forces rebuilding the cache (e.g. on MCM change)
-- Returns: item_order (table) - Map of [kind] = numeric priority
---------------------------------------------------------------------------------------
function ensure_sortingplus_cache(force_reload)
    if sp_item_order and not force_reload then
        return sp_item_order
    end

    sp_item_order     = {}
    sp_kind_overrides = {}
    sp_ui_categories  = {}

    if not sp_ini then
        sp_ini = ini_file("sortingplus.ltx")
    end

    if sp_ini and sp_ini:section_exist("item_kind_order") then
        -- 1. Load kind_overrides from sortingplus.ltx
        if sp_ini:section_exist("kind_overrides") then
            local n_ov = sp_ini:line_count("kind_overrides")
            for i = 0, n_ov - 1 do
                local _, sec, k_ov = sp_ini:r_line_ex("kind_overrides", i, "", "")
                if sec and k_ov and sec ~= "" and k_ov ~= "" then
                    sp_kind_overrides[sec] = k_ov
                end
            end
        end

        -- 2. Load default item_kind_order from sortingplus.ltx first
        local n_ko = sp_ini:line_count("item_kind_order")
        for i = 0, n_ko - 1 do
            local _, kind, order = sp_ini:r_line_ex("item_kind_order", i, "", "")
            if kind and order and kind ~= "" then
                sp_item_order[kind] = tonumber(order) or 30
            end
        end

        -- 3. Overlay user's MCM category values if `SortingPlus/useltx` is false
        local use_ltx = ui_mcm and ui_mcm.get and (ui_mcm.get("SortingPlus/useltx") == true)
        if not use_ltx and sp_ini:section_exist("sortingplusmcm") then
            local n_cat = sp_ini:line_count("sortingplusmcm")
            for i = 0, n_cat - 1 do
                local _, category, kinds = sp_ini:r_line_ex("sortingplusmcm", i, "", "")
                if category and kinds and (magazine_binder or not (category == "002mags" or category == "001loadout")) then
                    local exploded = str_explode(kinds, ",")
                    local def_num  = tonumber(exploded[1])
                    if def_num then
                        local mcm_num = (ui_mcm and ui_mcm.get and tonumber(ui_mcm.get("SortingPlus/" .. category))) or def_num
                        for k_idx = 2, #exploded do
                            local k_name = exploded[k_idx]
                            if k_name and k_name ~= "" then
                                sp_item_order[k_name] = mcm_num
                            end
                        end
                    end
                end
            end
        end

        sp_item_order["na"] = size_table(sp_item_order) + 1
        hcl_log(2, "ensure_sortingplus_cache", "Synced item_order table from sortingplus.ltx / MCM")
    else
        -- Fallback if sortingplus.ltx is not present
        copy_table(sp_item_order, DEFAULT_KIND_ORDER)
    end

    return sp_item_order
end

---------------------------------------------------------------------------------------
-- Queries `zzz_rax_sortingplus_mcm` (or `ish_favorites`) to check whether a section
-- is marked as Favorite or Junk by the player.
-- Arguments: sec (string) - Item section name
-- Returns: is_fav (boolean), is_junk (boolean)
---------------------------------------------------------------------------------------
function get_fav_junk_status(sec)
    if not sec then return false, false end
    local is_fav  = false
    local is_junk = false

    if zzz_rax_sortingplus_mcm then
        if zzz_rax_sortingplus_mcm.is_favorite and zzz_rax_sortingplus_mcm.is_favorite(sec) then
            is_fav = true
        end
        if zzz_rax_sortingplus_mcm.is_junk and zzz_rax_sortingplus_mcm.is_junk(sec) then
            is_junk = true
        end
    end
    if not is_fav and ish_favorites and ish_favorites.is_favorite and ish_favorites.is_favorite(sec) then
        is_fav = true
    end

    return is_fav, is_junk
end

---------------------------------------------------------------------------------------
-- Computes the exact SortingPlus kind string and numeric `item_order` priority for an
-- item, matching `zzz_rax_sortingplus_mcm.sort_by_kind` and `FindFreeCell` 1:1.
-- Arguments: item (game_object), sec (string)
-- Returns: sp_order (number), sort_k (string), macro_cat (number), is_fav (boolean), is_junk (boolean)
---------------------------------------------------------------------------------------
function get_item_sort_metadata(item, sec)
    local item_order = ensure_sortingplus_cache(false)
    local is_fav, is_junk = get_fav_junk_status(sec)

    -- 1. Determine base sort_kind exactly like `zzz_rax_sortingplus_mcm.get_sort_kind(sec)`
    local base_k = (magazine_binder and magazine_binder.is_magazine(sec) and "mags")
                   or sp_kind_overrides[sec]
                   or SYS_GetParam(0, sec, "kind", "na")
                   or "na"

    if not item_order[base_k] then
        base_k = "na"
    end

    local sort_k = base_k
    local sort_favs_on = (not zzz_rax_sortingplus_mcm) or (zzz_rax_sortingplus_mcm.SORTFAVS ~= false)
    local sort_junk_on = (not zzz_rax_sortingplus_mcm) or (zzz_rax_sortingplus_mcm.SORTJUNK ~= false)

    -- 2. Apply Loadout / Favorites / Junk overrides exactly like SortingPlus
    if magazine_binder and item and magazine_binder.is_carried_mag(item:id()) and item_order["loadout"] then
        sort_k = "loadout"
    elseif sort_favs_on and is_fav and item_order["favorites"] then
        sort_k = "favorites"
    elseif sort_junk_on and is_junk and item_order["junk"] then
        sort_k = "junk"
    end

    local sp_order = item_order[sort_k] or item_order[base_k] or item_order["na"] or 99

    -- Ensure Favorites/Junk still sort to top/bottom even if "favorites"/"junk" key wasn't in item_order
    if sort_favs_on and is_fav and not item_order["favorites"] then
        sp_order = -999
    elseif sort_junk_on and is_junk and not item_order["junk"] then
        sp_order = 999
    end

    -- 3. Macro-Category for Mode 2
    local macro_cat = MACRO_CATEGORY_MAP[base_k] or 4
    if sort_favs_on and is_fav then
        macro_cat = 0
    elseif sort_junk_on and is_junk then
        macro_cat = 5
    end

    return sp_order, sort_k, macro_cat, is_fav, is_junk
end

---------------------------------------------------------------------------------------
-- Finds the first free (row, col) coordinate in a 2D occupancy grid starting at or
-- below `min_start_row` that can fit an item of size (w, h), and marks it occupied.
-- Also returns `row_end` (the lowest row index occupied by this item, 1-indexed) to
-- mirror `UICellContainer.FindFreeCell`'s `self.row_end` behavior.
-- Arguments: grid (table), max_cols (number), w (number), h (number), min_start_row (number)
-- Returns: placed_col (number, 0-idx), placed_row (number, 0-idx), occupied_bottom_row (number, 1-idx)
---------------------------------------------------------------------------------------
local function place_in_occupancy_grid(grid, max_cols, w, h, min_start_row)
    local row = math.max(1, min_start_row or 1)
    while row < 200 do
        for col = 1, math.max(1, max_cols - w + 1) do
            local fits = true
            for r = row, row + h - 1 do
                grid[r] = grid[r] or {}
                for c = col, col + w - 1 do
                    if grid[r][c] then
                        fits = false
                        break
                    end
                end
                if not fits then break end
            end

            if fits then
                for r = row, row + h - 1 do
                    grid[r] = grid[r] or {}
                    for c = col, col + w - 1 do
                        grid[r][c] = true
                    end
                end
                return (col - 1), (row - 1), (row + h - 1)
            end
        end
        row = row + 1
    end
    return 0, 0, 1
end

---------------------------------------------------------------------------------------
-- Sorts `grouped_items`, assigns 2D grid coordinates according to the active MCM
-- `sort_mode` (1=Classic Size+Kind, 2=Macro-Category Rows, 3=SortingPlus Kind Rows),
-- re-sorts by visual reading order, and builds the 2D `ui.grid_rows` navigation matrix.
-- Arguments: ui (UIHoverCorpseLoot), grouped_items (table), use_tetris (boolean), cols (number)
-- Returns: max_col_used (number), max_row_used (number)
---------------------------------------------------------------------------------------
function sort_and_assign_rows(ui, grouped_items, use_tetris, cols)
    local sort_mode = hover_corpse_loot_mcm.get_config("sort_mode") or 2

    -- Step 1: Enrich each item entry with SortingPlus metadata
    for i = 1, #grouped_items do
        local d = grouped_items[i]
        local sp_order, sort_k, macro_cat, is_fav, is_junk = get_item_sort_metadata(d.item, d.sec)
        d.sp_order  = sp_order
        d.sort_k    = sort_k
        d.macro_cat = macro_cat
        d.is_fav    = is_fav
        d.is_junk   = is_junk

        if sort_mode == 2 then
            -- Mode 2: New row when Macro-Category changes
            d.row_group_key = macro_cat
        elseif sort_mode == 3 then
            -- Mode 3: Exact SortingPlus `FindFreeCell` behavior!
            -- Starts a new row ONLY when `item_order[sort_k]` (`sp_order`) changes!
            d.row_group_key = sp_order
        else
            -- Mode 1: Pack continuously without forced row breaks
            d.row_group_key = 0
        end
    end

    -- Step 2: Sort items before bin-packing using SortingPlus's exact tie-breakers:
    -- Width (`inv_w`) -> Height (`inv_h`) -> Alphabetical (`sec`) -> Condition (`cond`) -> ID
    table.sort(grouped_items, function(a, b)
        if sort_mode == 1 then
            -- Mode 1: Mirrors `zzz_rax_sortingplus_mcm.sort_by_sizekind`
            local a_override = (a.is_fav or a.is_junk)
            local b_override = (b.is_fav or b.is_junk)
            if a_override or b_override then
                if a.sp_order ~= b.sp_order then
                    return a.sp_order < b.sp_order
                end
            end
            if a.inv_w ~= b.inv_w then return a.inv_w > b.inv_w end
            if a.inv_h ~= b.inv_h then return a.inv_h > b.inv_h end
            if a.sp_order ~= b.sp_order then return a.sp_order < b.sp_order end
        else
            -- Mode 2 (Macro-Categories) & Mode 3 (SortingPlus Kind Rows):
            -- Mirrors `zzz_rax_sortingplus_mcm.sort_by_kind` -> `sort_by_size`
            if sort_mode == 2 and a.macro_cat ~= b.macro_cat then
                return a.macro_cat < b.macro_cat
            end
            if a.sp_order ~= b.sp_order then
                return a.sp_order < b.sp_order
            end
            if a.inv_w ~= b.inv_w then return a.inv_w > b.inv_w end
            if a.inv_h ~= b.inv_h then return a.inv_h > b.inv_h end
        end

        if a.sec ~= b.sec then return a.sec < b.sec end
        if a.cond and b.cond and a.cond ~= b.cond then return a.cond > b.cond end
        if a.item and b.item then return a.item:id() > b.item:id() end
        return false
    end)

    -- Step 3: Place items into 2D grid, matching `UICellContainer.FindFreeCell`:
    -- "when sorting a new kind, always start from last row taken by previous kind"
    local occupancy_grid = {}
    local max_col_used   = 0
    local max_row_used   = 0
    local current_min_r  = 1 -- 1-indexed for occupancy_grid
    local row_end        = 0
    local last_group_key = nil

    for idx = 1, #grouped_items do
        local data   = grouped_items[idx]
        local span_w = use_tetris and math.min(cols, data.inv_w) or 1
        local span_h = use_tetris and data.inv_h or 1

        if sort_mode ~= 1 and last_group_key ~= nil and data.row_group_key ~= last_group_key then
            current_min_r = row_end + 1
        end
        last_group_key = data.row_group_key

        local grid_c, grid_r, bottom_r = place_in_occupancy_grid(occupancy_grid, cols, span_w, span_h, current_min_r)
        data.grid_c = grid_c
        data.grid_r = grid_r
        data.span_w = span_w
        data.span_h = span_h

        row_end      = math.max(row_end, bottom_r)
        max_col_used = math.max(max_col_used, grid_c + span_w)
        max_row_used = math.max(max_row_used, grid_r + span_h)
    end

    -- Step 4: Re-sort by Visual Reading Order (Top-to-Bottom, Left-to-Right)
    table.sort(grouped_items, function(a, b)
        if a.grid_r ~= b.grid_r then return a.grid_r < b.grid_r end
        return a.grid_c < b.grid_c
    end)

    -- Step 5: Build the 2D Navigation Matrix (ui.grid_rows)
    local grid_rows = {}
    local row_map   = {}

    for idx = 1, #grouped_items do
        local data = grouped_items[idx]
        local r_key = data.grid_r
        local nav_r = row_map[r_key]
        if not nav_r then
            nav_r = #grid_rows + 1
            row_map[r_key] = nav_r
            grid_rows[nav_r] = {}
        end
        local row_list = grid_rows[nav_r]
        local nav_c = #row_list + 1
        row_list[nav_c] = idx

        data.nav_row = nav_r
        data.nav_col = nav_c
    end

    ui.grid_rows = grid_rows
    hcl_log(3, "sort_and_assign_rows", string.format("mode=%d items=%d nav_rows=%d", sort_mode, #grouped_items, #grid_rows))
    return max_col_used, max_row_used
end

-- Map Left/Right sibling keys so binding LSHIFT/LALT/LCONTROL also accepts RSHIFT/RALT/RCONTROL
local SIBLING_KEYS = {
    [DIK_keys.DIK_LSHIFT]   = DIK_keys.DIK_RSHIFT,
    [DIK_keys.DIK_RSHIFT]   = DIK_keys.DIK_LSHIFT,
    [DIK_keys.DIK_LMENU]    = DIK_keys.DIK_RMENU,
    [DIK_keys.DIK_RMENU]    = DIK_keys.DIK_LMENU,
    [DIK_keys.DIK_LCONTROL] = DIK_keys.DIK_RCONTROL,
    [DIK_keys.DIK_RCONTROL] = DIK_keys.DIK_LCONTROL,
}

---------------------------------------------------------------------------------------
-- Checks whether a configured MCM keybind (DIK code) is currently held down.
-- Uses Modded Exes `key_state(dik)` and automatically checks Left/Right sibling keys
-- for Shift, Alt, and Ctrl.
-- Arguments: dik_code (number|string) - The DIK key code from MCM
-- Returns: (boolean) - True if the key is currently held down
---------------------------------------------------------------------------------------
function is_hold_key_active(dik_code)
    local dik = tonumber(dik_code)
    if not dik or dik <= 0 then return false end
    if key_state then
        if key_state(dik) ~= 0 then
            return true
        end
        local sibling = SIBLING_KEYS[dik]
        if sibling and key_state(sibling) ~= 0 then
            return true
        end
    end
    return false
end

---------------------------------------------------------------------------------------
-- Navigates the 2D item grid by Row (Vertical) or Column/Category-Flow (Horizontal).
-- - Deferred Rehover Wake-Up: When `ui.selected_idx == nil`, checks if we are hovering
--   over `ui.last_active_corpse_id` with a saved `ui.last_active_sel_idx` and wakes up
--   at that exact slot on the first scroll tick!
-- - Horizontal (`Modifier + Scroll`, or Normal Scroll if `swap_scroll_axis` is true):
--   Flows continuously across all wrapped rows sharing `row_group_key` before looping!
-- - Vertical (`Normal Scroll`, or `Modifier + Scroll` if `swap_scroll_axis` is true):
--   Moves Up/Down between visual rows and resets to the 1st column by default.
-- Arguments: ui (UIHoverCorpseLoot), step (number: 1 = Down/Next, -1 = Up/Prev),
--            move_by_col (boolean: true = Column movement, false = Row movement)
-- Returns: new_selected_idx (number)
---------------------------------------------------------------------------------------
function navigate_grid(ui, step, move_by_col)
    local grouped   = ui.current_grouped
    local grid_rows = ui.grid_rows
    if not grouped or #grouped == 0 or not grid_rows or #grid_rows == 0 then
        return nil
    end

    -- First scroll tick on this corpse:
    -- If returning to the SAME corpse after looking away (`last_active_corpse_id == target_id`),
    -- restore `last_active_sel_idx` on wake-up! Otherwise select first item (or last row if scrolling up).
    if ui.selected_idx == nil or not grouped[ui.selected_idx] then
        if ui.last_active_corpse_id == ui.target_id and ui.last_active_sel_idx ~= nil then
            ui.selected_idx = clamp(ui.last_active_sel_idx, 1, #grouped)
            hcl_log(2, "navigate_grid", string.format("Rehover wake-up on corpse %s -> restored selected_idx=%d", tostring(ui.target_id), ui.selected_idx))
        elseif step > 0 then
            ui.selected_idx = 1
        else
            local last_row = grid_rows[#grid_rows]
            ui.selected_idx = last_row and last_row[1] or #grouped
        end
        return ui.selected_idx
    end

    -- Ergonomic auto-fallback: if there is only 1 row on the corpse, normal scroll moves across columns
    if #grid_rows == 1 then
        move_by_col = true
    end

    local cur_entry = grouped[ui.selected_idx]
    local cur_r     = cur_entry.nav_row or 1
    local cur_c     = cur_entry.nav_col or 1
    local cur_group = cur_entry.row_group_key

    if move_by_col then
        -- Build a continuous list of item indices across all contiguous rows sharing `cur_group`
        -- so multi-row categories (like 10 parts wrapped across 2 rows) scroll seamlessly!
        local span_indices = {}
        local pos_in_span  = 1

        -- Find the first row of this contiguous category block
        local start_r = cur_r
        while start_r > 1 do
            local prev_row_first = grouped[grid_rows[start_r - 1][1]]
            if prev_row_first and prev_row_first.row_group_key == cur_group then
                start_r = start_r - 1
            else
                break
            end
        end

        -- Find the last row of this contiguous category block
        local end_r = cur_r
        while end_r < #grid_rows do
            local next_row_first = grouped[grid_rows[end_r + 1][1]]
            if next_row_first and next_row_first.row_group_key == cur_group then
                end_r = end_r + 1
            else
                break
            end
        end

        for r = start_r, end_r do
            local r_list = grid_rows[r]
            if r_list then
                for c = 1, #r_list do
                    local item_idx = r_list[c]
                    span_indices[#span_indices + 1] = item_idx
                    if item_idx == ui.selected_idx then
                        pos_in_span = #span_indices
                    end
                end
            end
        end

        if #span_indices > 0 then
            local next_pos = pos_in_span + step
            if next_pos > #span_indices then
                next_pos = 1
            elseif next_pos < 1 then
                next_pos = #span_indices
            end
            ui.selected_idx = span_indices[next_pos]
        end
    else
        -- Vertical movement across rows
        local next_r = cur_r + step
        if next_r > #grid_rows then
            next_r = 1
        elseif next_r < 1 then
            next_r = #grid_rows
        end
        local target_row = grid_rows[next_r]
        if target_row and #target_row > 0 then
            local reset_col = hover_corpse_loot_mcm.get_config("reset_col_on_row")
            if reset_col ~= false then
                -- Default: always snap to the 1st column of the newly selected row
                ui.selected_idx = target_row[1]
            else
                -- Optional MCM behavior: preserve column index across rows
                local clamped_c = math.min(cur_c, #target_row)
                ui.selected_idx = target_row[clamped_c]
            end
        end
    end

    hcl_log(3, "navigate_grid", string.format("col_mode=%s step=%d new_idx=%s", tostring(move_by_col), step, tostring(ui.selected_idx)))
    return ui.selected_idx
end

---------------------------------------------------------------------------------------
-- Computes the dynamic number of items to sweep on the current scroll wheel tick based
-- on the time delta (`dt`) since the previous sweep tick and the MCM `sweep_vel_mult`
-- slider (0.0 = Off / strictly 1:1, 0.5 = Default gentle acceleration, up to 2.0x).
-- Uses a fractional accumulator (`sweep_vel_accum`) so low slider values (like 0.2 or 0.5)
-- smoothly add +1 extra item every few rapid ticks instead of jumping to instant row-wipes!
-- Arguments: tg (number), step (number), total_items (number)
-- Returns: burst_count (number) - Number of items to sweep in this scroll tick (1 to 4)
---------------------------------------------------------------------------------------
local function compute_sweep_velocity_burst(tg, step, total_items)
    local dt = tg - last_sweep_tick_t
    local same_dir = (last_sweep_dir == step)
    last_sweep_tick_t = tg
    last_sweep_dir    = step

    local vel_mult = hover_corpse_loot_mcm.get_config("sweep_vel_mult") or 0.5
    if vel_mult <= 0 or not same_dir or dt <= 0 or dt > 75 then
        -- Deliberate / normal scroll or direction change: reset accumulator and stay strictly 1:1
        sweep_vel_accum = 0.0
        return 1
    end

    -- Smooth normalized speed factor in [0.0, 1.0] as `dt` drops from 75ms down to 15ms
    local speed_norm = (75 - math.max(15, dt)) / 60
    -- Gentle gain per rapid scroll tick:
    -- At vel_mult = 0.2 -> adds ~0.10 to 0.17 per fast tick (+1 extra item every 6-8 fast ticks)
    -- At vel_mult = 0.5 -> adds ~0.25 to 0.42 per fast tick (+1 extra item every 3-4 fast ticks)
    -- At vel_mult = 1.0 -> adds ~0.50 to 0.85 per fast tick (+1 extra item every 1-2 fast ticks)
    -- At vel_mult = 2.0 -> adds ~1.00 to 1.70 per fast tick (+1 to +2 extra items per fast tick)
    local gain = speed_norm * vel_mult * 0.85
    sweep_vel_accum = sweep_vel_accum + gain

    local extra = math.floor(sweep_vel_accum)
    if extra >= 1 then
        sweep_vel_accum = sweep_vel_accum - extra
    end

    return clamp(1 + extra, 1, 4)
end

---------------------------------------------------------------------------------------
-- Executes a single atomic step of the Bidirectional Hold Left Click + Scroll
-- "Row-Sweep" loot action and returns whether a category/row boundary was crossed so
-- the caller can stop any multi-item velocity burst and engage the brake.
-- Arguments: ui (UIHoverCorpseLoot), step (number), tg (number), brake_ms (number)
-- Returns: took (boolean), hit_row_boundary (boolean)
---------------------------------------------------------------------------------------
local function execute_single_sweep_take(ui, step, tg, brake_ms)
    if not ui or not ui:IsShown() or not ui.selected_idx or not ui.target_id then
        return false, true
    end

    local grouped   = ui.current_grouped
    local grid_rows = ui.grid_rows
    if not grouped or #grouped == 0 or not grid_rows then
        return false, true
    end

    local cur_entry = grouped[ui.selected_idx]
    if not cur_entry then
        return false, true
    end

    local cur_r     = cur_entry.nav_row or 1
    local cur_c     = cur_entry.nav_col or 1
    local cur_group = cur_entry.row_group_key
    local row_list  = grid_rows[cur_r]
    local row_len   = row_list and #row_list or 1

    -- Check if there is a continuation row of the SAME category in the sweep direction
    local adj_row_same_group = false
    if step > 0 then
        if cur_r < #grid_rows and grid_rows[cur_r + 1] and grid_rows[cur_r + 1][1] then
            local below_entry = grouped[grid_rows[cur_r + 1][1]]
            if below_entry and below_entry.row_group_key == cur_group then
                adj_row_same_group = true
            end
        end
    else
        if cur_r > 1 and grid_rows[cur_r - 1] and grid_rows[cur_r - 1][1] then
            local above_entry = grouped[grid_rows[cur_r - 1][1]]
            if above_entry and above_entry.row_group_key == cur_group then
                adj_row_same_group = true
            end
        end
    end

    -- Check if taking this item/stack will remove the entry from the grid
    local stack_mode = hover_corpse_loot_mcm.get_config("stack_mode") or 1
    local entry_will_be_removed = (stack_mode == 1) or (cur_entry.count <= 1 and (not cur_entry.raw_list or #cur_entry.raw_list <= 1))
    local row_will_empty = entry_will_be_removed and (row_len <= 1)

    -- Perform the actual item transfer via quickloot module
    local took = hover_corpse_loot_quickloot.action_take_selected()
    if not took then
        return false, true
    end

    -- Re-align selection index after UI rebuilds `ui.current_grouped` and `ui.grid_rows`
    local new_rows = ui.grid_rows
    if not new_rows or #new_rows == 0 then
        ui.selected_idx = nil
        return true, true
    end

    local hit_boundary = false

    if step > 0 then
        -- ============================================================================
        -- LMB + SCROLL DOWN: Sweep Rightward -> Reset to FIRST index of new row
        -- ============================================================================
        if row_will_empty then
            local next_r = math.min(cur_r, #new_rows)
            local target_row = new_rows[next_r]
            ui.selected_idx = (target_row and target_row[1]) or 1

            -- Only stop the burst and engage the brake when the ENTIRE category finishes
            -- (if `adj_row_same_group` is true, allow velocity bursts to flow across wrapped rows!)
            if not adj_row_same_group then
                hit_boundary     = true
                row_sweep_lock_t = tg + brake_ms
                hcl_log(2, "action_row_sweep_take", string.format("Right-sweep finished row %d! Engaging %dms brake", cur_r, brake_ms))
            end
        else
            local same_row = new_rows[cur_r]
            if same_row and #same_row > 0 then
                local next_c = math.min(cur_c, #same_row)
                ui.selected_idx = same_row[next_c]
            end
        end
    else
        -- ============================================================================
        -- LMB + SCROLL UP: Feed Leftward -> When reaching left edge (cur_c == 1),
        -- jump to the LAST index of the PREVIOUS row and engage the safety brake!
        -- ============================================================================
        if row_will_empty or (entry_will_be_removed and cur_c <= 1) then
            local prev_r
            if cur_r > 1 then
                prev_r = math.min(cur_r - 1, #new_rows)
            else
                prev_r = #new_rows
            end

            local target_row = new_rows[prev_r]
            ui.selected_idx = (target_row and target_row[#target_row]) or 1

            if not adj_row_same_group then
                hit_boundary     = true
                row_sweep_lock_t = tg + brake_ms
                hcl_log(2, "action_row_sweep_take", string.format("Left-sweep reached left edge of row %d! Jumped to end of row %d with %dms brake", cur_r, prev_r, brake_ms))
            end
        else
            local same_row = new_rows[cur_r]
            if same_row and #same_row > 0 then
                if entry_will_be_removed then
                    local next_c = math.min(cur_c - 1, #same_row)
                    ui.selected_idx = same_row[next_c]
                else
                    ui.selected_idx = same_row[math.min(cur_c, #same_row)]
                end
            end
        end
    end

    return true, hit_boundary
end

---------------------------------------------------------------------------------------
-- Executes the Bidirectional Hold Left Click + Scroll "Row-Sweep" loot action with
-- Dynamic Scroll-Velocity Scaling (`sweep_vel_mult`):
-- TRICKY X-RAY ENGINE WORKAROUND:
-- In X-Ray Engine, `npc:transfer_item(itm, db.actor)` is ASYNCHRONOUS! The transferred
-- item is NOT removed from `npc:iterate_inventory()` until the next engine update tick.
-- Therefore, calling `UpdateCorpseData` multiple times inside the same `on_mouse_wheel`
-- frame returns the exact same `ui.current_grouped` list and transfers the same 1st item
-- repeatedly! To sweep `burst` items in a single scroll tick, we collect all `burst`
-- target entries directly from `ui.grid_rows` in memory, transfer all of them in a
-- single batch, remove them from `ui.current_grouped` immediately, and rebuild the grid!
-- Arguments: ui (UIHoverCorpseLoot), step (number: 1 = Down/Right, -1 = Up/Left)
-- Returns: (boolean) - True if one or more items were taken
---------------------------------------------------------------------------------------
function action_row_sweep_take(ui, step)
    step = step or 1
    local tg = time_global()
    local brake_ms = hover_corpse_loot_mcm.get_config("row_sweep_cooldown") or 450

    -- Rolling Brake: If we just finished sweeping a category/row, block further
    -- LMB+Scroll ticks and refresh the brake timer until the player pauses scrolling!
    if tg < row_sweep_lock_t then
        row_sweep_lock_t  = tg + math.min(350, brake_ms)
        last_sweep_tick_t = 0
        sweep_vel_accum   = 0.0
        hcl_log(2, "action_row_sweep_take", "Row-end rolling brake active; blocking accidental next-row loot")
        return false
    end

    if not ui or not ui:IsShown() or not ui.selected_idx or not ui.target_id then
        return false
    end

    local npc = level.object_by_id(ui.target_id)
    if not npc then return false end

    local grouped   = ui.current_grouped
    local grid_rows = ui.grid_rows
    if not grouped or #grouped == 0 or not grid_rows then return false end

    local cur_entry = grouped[ui.selected_idx]
    if not cur_entry then return false end

    local cur_r      = cur_entry.nav_row or 1
    local cur_c      = cur_entry.nav_col or 1
    local cur_group  = cur_entry.row_group_key
    local stack_mode = hover_corpse_loot_mcm.get_config("stack_mode") or 1
    local burst      = compute_sweep_velocity_burst(tg, step, #grouped)

    -- 1. Build the ordered list of candidate item indices in the sweep direction across
    --    the current row (and any contiguous wrapped rows of the SAME `cur_group` category)
    local sweep_candidates = {}
    if step > 0 then
        -- Rightward sweep: from `cur_c` to end of `cur_r`, plus subsequent rows with same `cur_group`
        local r = cur_r
        while r <= #grid_rows do
            local r_list = grid_rows[r]
            if not r_list or #r_list == 0 then break end
            local first_e = grouped[r_list[1]]
            if r > cur_r and (not first_e or first_e.row_group_key ~= cur_group) then
                break
            end
            local start_c = (r == cur_r) and cur_c or 1
            for c = start_c, #r_list do
                sweep_candidates[#sweep_candidates + 1] = r_list[c]
            end
            r = r + 1
        end
    else
        -- Leftward sweep: from `cur_c` down to 1 in `cur_r`, plus preceding rows with same `cur_group`
        local r = cur_r
        while r >= 1 do
            local r_list = grid_rows[r]
            if not r_list or #r_list == 0 then break end
            local first_e = grouped[r_list[1]]
            if r < cur_r and (not first_e or first_e.row_group_key ~= cur_group) then
                break
            end
            local start_c = (r == cur_r) and cur_c or #r_list
            for c = start_c, 1, -1 do
                sweep_candidates[#sweep_candidates + 1] = r_list[c]
            end
            r = r - 1
        end
    end

    if #sweep_candidates == 0 then return false end

    -- 2. Mark corpse as searched/looted once before transferring the batch
    if hover_corpse_loot_quickloot and hover_corpse_loot_quickloot.trigger_corpse_searched_callbacks then
        hover_corpse_loot_quickloot.trigger_corpse_searched_callbacks(npc)
    end

    -- 3. Transfer up to `burst` items/stacks in a single synchronous batch!
    local num_to_sweep   = math.min(burst, #sweep_candidates)
    local swept_All_cat  = (num_to_sweep >= #sweep_candidates)
    local transferred_ids = {}
    local any_transferred = false

    for i = 1, num_to_sweep do
        local idx   = sweep_candidates[i]
        local entry = grouped[idx]
        if entry then
            if stack_mode == 1 and entry.raw_list and #entry.raw_list > 1 then
                for j = 1, #entry.raw_list do
                    local itm = entry.raw_list[j]
                    if itm then
                        npc:transfer_item(itm, db.actor)
                        transferred_ids[itm:id()] = true
                        any_transferred = true
                    end
                end
            elseif stack_mode == 2 and entry.raw_list and #entry.raw_list > 1 then
                -- Single-item stack mode: take up to `burst` individual items from the stack
                local itm = entry.raw_list[1]
                if itm then
                    npc:transfer_item(itm, db.actor)
                    transferred_ids[itm:id()] = true
                    any_transferred = true
                end
                swept_All_cat = false
                break
            else
                if entry.item then
                    npc:transfer_item(entry.item, db.actor)
                    transferred_ids[entry.item:id()] = true
                    any_transferred = true
                end
            end
        end
    end

    if not any_transferred then return false end

    hcl_log(2, "action_row_sweep_take", string.format("Velocity Sweep (burst=%d, swept=%d/%d in cat, step=%d)", burst, num_to_sweep, #sweep_candidates, step))

    -- 4. Store `ui.pending_transferred_ids` so `GetRawCorpseItems` immediately excludes
    --    items transferred on this frame even before X-Ray's async transfer finishes!
    ui.pending_transferred_ids = ui.pending_transferred_ids or {}
    for id_k, _ in pairs(transferred_ids) do
        ui.pending_transferred_ids[id_k] = tg + 250
    end

    -- 5. Rebuild the UI grid with the newly filtered items and position the cursor
    ui:UpdateCorpseData(npc, true)

    local new_rows = ui.grid_rows
    if not new_rows or #new_rows == 0 then
        ui.selected_idx = nil
        return true
    end

    if step > 0 then
        if swept_All_cat then
            local next_r = math.min(cur_r, #new_rows)
            local target_row = new_rows[next_r]
            ui.selected_idx = (target_row and target_row[1]) or 1
            row_sweep_lock_t = tg + brake_ms
            hcl_log(2, "action_row_sweep_take", string.format("Right-sweep finished category at row %d! Engaging %dms brake", cur_r, brake_ms))
        else
            local same_row = new_rows[cur_r]
            if same_row and #same_row > 0 then
                ui.selected_idx = same_row[math.min(cur_c, #same_row)]
            end
        end
    else
        if swept_All_cat or cur_c - num_to_sweep < 1 then
            local prev_r = (cur_r > 1) and math.min(cur_r - 1, #new_rows) or #new_rows
            local target_row = new_rows[prev_r]
            ui.selected_idx = (target_row and target_row[#target_row]) or 1
            if swept_All_cat then
                row_sweep_lock_t = tg + brake_ms
                hcl_log(2, "action_row_sweep_take", string.format("Left-sweep finished category at row %d! Engaging %dms brake", cur_r, brake_ms))
            end
        else
            local same_row = new_rows[cur_r]
            if same_row and #same_row > 0 then
                local next_c = math.max(1, math.min(cur_c - num_to_sweep, #same_row))
                ui.selected_idx = same_row[next_c]
            end
        end
    end

    ui:UpdateCorpseData(npc, true)
    return true
end


-- ====================================================================================
-- EASY TWEAK TABLE: FIELD STRIP PDA MESSAGE CONDITION COLOR TIERS
-- Ordered from highest `min_cond` to lowest. Edit `min_cond` or `clr` anytime!
-- ====================================================================================
local STRIP_COND_COLOR_TIERS = {
    { min_cond = 60, clr = "%c[255,107,207,119]" }, -- 60% and above : Green
    { min_cond = 40, clr = "%c[255,255,255,118]" }, -- 40% to 59%    : Yellow
    { min_cond = 20, clr = "%c[255,235,135,30]"  }, -- 20% to 39%    : Orange
    { min_cond = 0,  clr = "%c[255,196,18,18]"   }, -- Below 20%     : Red
}

local PDA_CLR_DEFAULT = "%c[default]"
local PDA_CLR_HEADER  = "%c[255,220,220,220]"
local PDA_CLR_BULLET  = "%c[255,170,170,170]"
local PDA_CLR_ATTACH  = "%c[255,107,207,119]"

---------------------------------------------------------------------------------------
-- Returns the PDA color tag string for a given part condition percentage (0-100)
-- using the `STRIP_COND_COLOR_TIERS` lookup table above.
-- Arguments: cond_pct (number) - Condition percentage (0 to 100)
-- Returns: (string) - X-Ray `%c[A,R,G,B]` color code string
---------------------------------------------------------------------------------------
local function get_part_cond_color_tag(cond_pct)
    for i = 1, #STRIP_COND_COLOR_TIERS do
        local tier = STRIP_COND_COLOR_TIERS[i]
        if cond_pct >= tier.min_cond then
            return tier.clr
        end
    end
    return "%c[255,196,18,18]"
end

---------------------------------------------------------------------------------------
-- Sends a formatted multi-line PDA notification message on the HUD.
-- TRICKY WORKAROUND: `db.actor:give_game_news` does not parse `\\n` tokens unless routed
-- through `news_manager.send_tip` (which runs `utils_data.parse_string_keys` to convert
-- `\\n` into real engine line breaks, matching WPO's `zzzz_arti_jamming_repairs.script`).
-- Arguments: header_str (string), body_str (string)
-- Returns: None
---------------------------------------------------------------------------------------
local function send_hcl_pda_tip(header_str, body_str)
    if not db.actor then return end
    local full_msg = string.format("%s%s:%s\\n%s", PDA_CLR_HEADER, tostring(header_str), PDA_CLR_DEFAULT, tostring(body_str))
    if news_manager and news_manager.send_tip then
        news_manager.send_tip(db.actor, full_msg, nil, "swiss_knife", 5000)
    else
        local icon = "ui_inGame2_Predmet_otdan"
        db.actor:give_game_news(header_str, string.gsub(body_str, "\\\\n", "\n"), icon, 0, 5000)
    end
end

---------------------------------------------------------------------------------------
-- Strips attached Scopes and Silencers/Suppressors from a weapon on a corpse into the
-- player's inventory when `strip_attachments` is enabled in MCM.
-- Handles both native engine addons (`weapon_addon_detach` / `utils_item.detach_addon`)
-- and parent/child section scopes (`alife_clone_weapon`), clearing server `addon_flags`
-- and verifying actual detachment to prevent any attachment duplication glitches!
-- Arguments: obj (game_object), sec (string), parent_sec (string), se_parts (table)
-- Returns: att_lines (table), att_count (number), was_cloned (boolean)
---------------------------------------------------------------------------------------
local function strip_weapon_attachments(obj, sec, parent_sec, se_parts)
    local att_lines  = {}
    local att_count  = 0
    local was_cloned = false

    if hover_corpse_loot_mcm.get_config("strip_attachments") == false then
        return att_lines, att_count, was_cloned
    end

    -- 1. Identify Attached Scope (Supports both Parent/Child Section Scopes & Native Addon Scopes)
    local scope_sec      = nil
    local is_child_scope = false

    if utils_item and utils_item.has_scope then
        local child_sc = utils_item.has_scope(sec)
        if child_sc and type(child_sc) == "string" and ini_sys:section_exist(child_sc) then
            scope_sec      = child_sc
            is_child_scope = true
        end
    end

    if not scope_sec and parent_sec and sec ~= parent_sec then
        local suffix = string.gsub(sec, "^" .. string.gsub(parent_sec, "([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1") .. "_", "")
        if suffix and suffix ~= sec and ini_sys:section_exist(suffix) then
            scope_sec      = suffix
            is_child_scope = true
        end
    end

    if not scope_sec and obj.weapon_scope_status and obj:weapon_scope_status() == 2 then
        local has_sc = (utils_item and utils_item.addon_attached and utils_item.addon_attached(obj, "sc"))
                       or (utils_item and utils_item.has_attached_scope and utils_item.has_attached_scope(obj))
        if has_sc then
            local scope_sect = SYS_GetParam(0, sec, "scopes_sect")
            scope_sec = (scope_sect and SYS_GetParam(0, scope_sect, "scope_name"))
                        or SYS_GetParam(0, sec, "scope_name")
                        or (utils_item and utils_item.get_attached_scope and utils_item.get_attached_scope(obj))
        end
    end

    -- 2. Identify Attached Silencer / Suppressor
    local sil_sec = nil
    if obj.weapon_silencer_status and obj:weapon_silencer_status() == 2 then
        local has_sil = (obj.weapon_is_silencer and obj:weapon_is_silencer())
                        or (utils_item and utils_item.addon_attached and utils_item.addon_attached(obj, "sl"))
                        or (utils_item and utils_item.has_attached_silencer and utils_item.has_attached_silencer(obj))
        if has_sil then
            sil_sec = SYS_GetParam(0, sec, "silencer_name") or SYS_GetParam(0, parent_sec, "silencer_name")
        end
    end

    -- 3. Detach Silencer first with strict anti-duplication verification!
    --    NOTE: `utils_item.detach_addon` expects `"sil"` (not `"silencer"`), and on a corpse's
    --    weapon we also call `obj:weapon_addon_detach(sil_sec, false)` and strip the server
    --    packet's suppressor flag (`addon_flags` bit 4) so `alife_clone_weapon` never clones it back!
    local sil_detached = false
    if sil_sec and ini_sys:section_exist(sil_sec) then
        if obj.weapon_addon_detach then
            pcall(function() obj:weapon_addon_detach(sil_sec, false) end)
        end
        if utils_item and utils_item.detach_addon then
            pcall(utils_item.detach_addon, obj, sil_sec, "sil", false)
        end

        -- Also clear the suppressor bit (bit 4) on the server object's stpk packet so
        -- `alife_clone_weapon` (if a child-section scope is also stripped) won't re-attach it!
        local se_wpn = alife_object(obj:id())
        if se_wpn and utils_stpk and utils_stpk.get_weapon_data and utils_stpk.set_weapon_data then
            local w_data = utils_stpk.get_weapon_data(se_wpn)
            if w_data and w_data.addon_flags and bit_and(w_data.addon_flags, 4) ~= 0 then
                w_data.addon_flags = bit_and(w_data.addon_flags, bit_not(4))
                utils_stpk.set_weapon_data(w_data, se_wpn)
                sil_detached = true
            end
        end

        local still_has_sil = (obj.weapon_is_silencer and obj:weapon_is_silencer())
                              or (utils_item and utils_item.addon_attached and utils_item.addon_attached(obj, "sl"))
        if not still_has_sil then
            sil_detached = true
        end

        -- Fallback: If `weapon_addon_detach` is ignored by the engine because the gun is inside a
        -- corpse inventory (and not in actor hands/inventory), clone the weapon with `addon_flags` cleared!
        if not sil_detached and not (is_child_scope and parent_sec and sec ~= parent_sec) then
            if se_wpn and alife_clone_weapon then
                local se_new = alife_clone_weapon(se_wpn, sec)
                if se_new then
                    was_cloned   = true
                    sil_detached = true
                    if utils_stpk and utils_stpk.get_weapon_data and utils_stpk.set_weapon_data then
                        local new_data = utils_stpk.get_weapon_data(se_new)
                        if new_data and new_data.addon_flags then
                            new_data.addon_flags = bit_and(new_data.addon_flags, bit_not(4))
                            utils_stpk.set_weapon_data(new_data, se_new)
                        end
                    end
                    if se_parts and item_parts and item_parts.set_parts_con then
                        item_parts.set_parts_con(se_new.id, se_parts)
                    end
                end
            end
        end

        if sil_detached or (is_child_scope and parent_sec and sec ~= parent_sec) then
            alife_create_item(sil_sec, db.actor)
            att_count = att_count + 1
            sil_detached = true
        end
    end

    -- 4. Detach Scope and transfer to player inventory
    local scope_detached = false
    if scope_sec and ini_sys:section_exist(scope_sec) then
        if is_child_scope and parent_sec and sec ~= parent_sec and ini_sys:section_exist(parent_sec) then
            local se_old = alife_object(obj:id())
            if se_old and alife_clone_weapon then
                local se_new = alife_clone_weapon(se_old, parent_sec)
                if se_new then
                    was_cloned     = true
                    scope_detached = true
                    -- Ensure suppressor bit is also cleared on the newly cloned weapon if we stripped a silencer
                    if sil_detached and utils_stpk and utils_stpk.get_weapon_data and utils_stpk.set_weapon_data then
                        local new_data = utils_stpk.get_weapon_data(se_new)
                        if new_data and new_data.addon_flags then
                            new_data.addon_flags = bit_and(new_data.addon_flags, bit_not(4))
                            utils_stpk.set_weapon_data(new_data, se_new)
                        end
                    end
                    if se_parts and item_parts and item_parts.set_parts_con then
                        se_parts[parent_sec] = se_parts[sec] or math.ceil(obj:condition() * 100)
                        item_parts.set_parts_con(se_new.id, se_parts)
                    end
                    alife_create_item(scope_sec, db.actor)
                    att_count = att_count + 1
                end
            end
        else
            if obj.weapon_addon_detach then
                pcall(function() obj:weapon_addon_detach(scope_sec, false) end)
            end
            if utils_item and utils_item.detach_addon then
                pcall(utils_item.detach_addon, obj, scope_sec, "scope", false)
            end
            local still_has_sc = utils_item and utils_item.addon_attached and utils_item.addon_attached(obj, "sc")
            if not still_has_sc then
                scope_detached = true
                alife_create_item(scope_sec, db.actor)
                att_count = att_count + 1
            end
        end
    end

    -- 5. Build PDA lines with Scope listed first, followed by Silencer
    if scope_detached and scope_sec then
        local sc_name = ui_item.get_sec_name(scope_sec) or scope_sec
        att_lines[#att_lines + 1] = string.format(
            "%s - %s%s%s",
            PDA_CLR_BULLET,
            PDA_CLR_ATTACH,
            sc_name,
            PDA_CLR_DEFAULT
        )
    end
    if sil_detached and sil_sec then
        local sl_name = ui_item.get_sec_name(sil_sec) or sil_sec
        att_lines[#att_lines + 1] = string.format(
            "%s - %s%s%s",
            PDA_CLR_BULLET,
            PDA_CLR_ATTACH,
            sl_name,
            PDA_CLR_DEFAULT
        )
    end

    return att_lines, att_count, was_cloned
end

---------------------------------------------------------------------------------------
-- Field Strips attached Scopes/Silencers (if enabled in MCM) and all valid, non-barrel
-- weapon parts meeting or exceeding the MCM `strip_min_cond` threshold from the selected
-- weapon in the Hover UI.
-- Spawns stripped attachments/parts directly in the player's inventory, updates the
-- weapon's part states and condition on the corpse, refreshes the UI, and sends a
-- multi-line colored PDA notification (using X-Ray's `\\n` line breaks).
-- Arguments: ui (UIHoverCorpseLoot)
-- Returns: (boolean) - True if attachments or parts were stripped
---------------------------------------------------------------------------------------
function action_field_strip_selected(ui)
    if not ui or not ui:IsShown() or not ui.selected_idx or not ui.target_id then
        return false
    end

    local npc = level.object_by_id(ui.target_id)
    if not npc then return false end

    local grouped = ui.current_grouped
    local entry   = grouped and grouped[ui.selected_idx]
    local obj     = entry and entry.item
    if not obj then return false end

    local sec      = obj:section()
    local clsid    = obj:clsid()
    local is_wpn   = IsWeapon(obj, clsid)
    local is_melee = IsMelee and IsMelee(obj, clsid) or false

    if not is_wpn or is_melee or IsItem("fake_ammo_wpn", sec) then
        return false
    end

    if not (item_parts and itms_manager) then return false end

    local parent_sec = SYS_GetParam(0, sec, "parent_section") or sec
    local parts_str  = itms_manager.ini_parts and itms_manager.ini_parts:r_string_ex("con_parts_list", parent_sec)
    local se_parts   = parts_str and item_parts.get_parts_con(obj, nil, true) or nil

    local min_cond = hover_corpse_loot_mcm.get_config("strip_min_cond") or 60
    local wpn_name = ui_item.get_sec_name(sec) or sec

    -- 1. Strip internal weapon parts first (so `se_parts` and condition are ready before any scope clone)
    local sort_fn        = (z_item_icon_info and z_item_icon_info.parts_sort) or nil
    local stripped_lines = {}
    local stripped_count = 0
    local remaining_sum  = 0
    local total_parts_n  = 0

    if se_parts and not is_empty(se_parts) then
        for part_sec, cond in spairs(se_parts, sort_fn) do
            if part_sec ~= parent_sec and part_sec ~= sec and SYS_GetParam(1, part_sec, "cond_part", false) then
                total_parts_n = total_parts_n + 1
                local is_barrel = (string.find(part_sec, "barrel") ~= nil)
                                  or (arti_jamming and arti_jamming.is_barrel and arti_jamming.is_barrel(part_sec))

                if (not is_barrel) and cond and cond >= min_cond and cond > 0 then
                    -- Spawn the stripped part in the player's inventory with its exact condition
                    alife_create_item(part_sec, db.actor, { cond = clamp(cond / 100, 0.01, 1.0) })

                    -- Mark part as stripped (-1) on the weapon
                    se_parts[part_sec] = -1
                    stripped_count = stripped_count + 1

                    -- Build Colored PDA line using full part name and STRIP_COND_COLOR_TIERS
                    local part_full_name = ui_item.get_sec_name(part_sec) or part_sec
                    local clr_tag        = get_part_cond_color_tag(cond)
                    stripped_lines[#stripped_lines + 1] = string.format(
                        "%s - %s: %s%d%%%s",
                        PDA_CLR_BULLET,
                        part_full_name,
                        clr_tag,
                        math.floor(cond),
                        PDA_CLR_DEFAULT
                    )
                else
                    if cond and cond > 0 then
                        remaining_sum = remaining_sum + cond
                    end
                end
            end
        end
    end

    if stripped_count > 0 and se_parts then
        -- Save modified parts table back to the weapon and update its overall condition BEFORE cloning
        if total_parts_n > 0 then
            local new_wpn_cond = clamp((remaining_sum / (total_parts_n * 100)), 0.03, 1.0)
            obj:set_condition(new_wpn_cond)
            se_parts[parent_sec] = math.ceil(new_wpn_cond * 100)
        end
        item_parts.set_parts_con(obj:id(), se_parts)
    end

    -- 2. Strip attached Scopes & Silencers (if `strip_attachments` is enabled in MCM)
    local att_lines, att_count, was_cloned = strip_weapon_attachments(obj, sec, parent_sec, se_parts)

    local hdr_title = game.translate_string("st_hcl_pda_strip_title")

    -- 3. If neither attachments nor parts were stripped, display the threshold message
    if att_count == 0 and stripped_count == 0 then
        local none_msg = string.format(
            "%s%s:%s %s (>= %d%%)",
            PDA_CLR_HEADER,
            wpn_name,
            PDA_CLR_DEFAULT,
            game.translate_string("st_hcl_pda_strip_none"),
            min_cond
        )
        send_hcl_pda_tip(hdr_title, none_msg)
        return false
    end

    -- 4. Combine PDA lines with stripped attachments at the top, followed by stripped weapon parts
    --    NOTE: X-Ray's `give_game_news` XML text parser requires literal `\\n` for line breaks!
    local all_lines = {}
    for i = 1, #att_lines do
        all_lines[#all_lines + 1] = att_lines[i]
    end
    for i = 1, #stripped_lines do
        all_lines[#all_lines + 1] = stripped_lines[i]
    end

    -- Notify WPO / arti_jamming if present and play field-strip sound
    if not was_cloned and arti_jamming and arti_jamming.on_strip then
        pcall(arti_jamming.on_strip, obj)
    end
    if utils_obj and utils_obj.play_sound then
        utils_obj.play_sound("interface\\inv_detach_addon")
    end

    -- Mark corpse as searched/looted
    if hover_corpse_loot_quickloot and hover_corpse_loot_quickloot.trigger_corpse_searched_callbacks then
        hover_corpse_loot_quickloot.trigger_corpse_searched_callbacks(npc)
    end

    -- Send consolidated Colored PDA Summary with X-Ray `\\n` line breaks
    local pda_body = string.format(
        "%s%s:%s\\n%s",
        PDA_CLR_HEADER,
        wpn_name,
        PDA_CLR_DEFAULT,
        table.concat(all_lines, "\\n")
    )
    send_hcl_pda_tip(hdr_title, pda_body)

    hcl_log(2, "action_field_strip_selected", string.format("Stripped %d attachments and %d parts (>=%d%%) from %s (cloned=%s)", att_count, stripped_count, min_cond, sec, tostring(was_cloned)))

    -- Immediately refresh the Hover UI (and schedule a follow-up refresh if `alife_clone_weapon` was used)
    ui:UpdateCorpseData(npc, true)
    if was_cloned then
        local target_npc_id = ui.target_id
        local prev_sel_idx  = ui.selected_idx
        CreateTimeEvent("hcl_strip_clone_refresh", "hcl_strip_ref_" .. tostring(target_npc_id), 0.12, function()
            local active_ui = hover_corpse_loot_ui and hover_corpse_loot_ui.get_ui()
            if active_ui and active_ui:IsShown() and active_ui.target_id == target_npc_id then
                local corpse = level.object_by_id(target_npc_id)
                if corpse then
                    if active_ui.selected_idx == nil then
                        active_ui.selected_idx = prev_sel_idx
                    end
                    active_ui:UpdateCorpseData(corpse, true)
                end
            end
            return true
        end)
    end
    return true
end

-- Timestamp debounce to prevent double-clicking Disassemble on the same frame
local last_disassemble_t = 0

---------------------------------------------------------------------------------------
-- Disassembles the currently selected item in the Hover UI using Anomaly/GAMMA's
-- native `item_parts.func_disassembly(obj)` so all mod monkey-patches and tool checks
-- execute natively.
-- TRICKY WORKAROUND: Vanilla `item_parts.timer_disassembly_item` calls
-- `ui_inventory.GUI:UpdateInfo(true)` when the disassembly timer finishes, which crashes
-- or fails if `ui_inventory.GUI` hasn't been initialized yet OR if `obj:parent()` was
-- a corpse! To make `item_parts.func_disassembly(obj)` 100% safe and compatible with
-- every GAMMA mod hook without opening the inventory GUI, we ensure `ui_inventory.GUI`
-- exists and schedule a UI refresh when the item is released.
-- Arguments: ui (UIHoverCorpseLoot), is_sweep (boolean - optional, lowers debounce for sweep mode)
-- Returns: (boolean) - True if disassembly was initiated
---------------------------------------------------------------------------------------
function action_disassemble_selected(ui, is_sweep)
    local tg = time_global()
    if tg < last_disassemble_t then return false end

    if not ui or not ui:IsShown() or not ui.selected_idx or not ui.target_id then
        return false
    end

    local npc = level.object_by_id(ui.target_id)
    if not npc then return false end

    local grouped = ui.current_grouped
    local entry   = grouped and grouped[ui.selected_idx]
    local obj     = entry and entry.item
    if not obj or not item_parts or not item_parts.func_disassembly then
        return false
    end

    last_disassemble_t = tg + (is_sweep and 90 or 400)

    -- Ensure ui_inventory.GUI singleton exists in memory so vanilla timer_disassembly_item's
    -- `ui_inventory.GUI:UpdateInfo(true)` call at the end of the timer never hits a nil GUI!
    if ui_inventory and not ui_inventory.GUI then
        ui_inventory.GUI = ui_inventory.UIInventory()
    end

    -- Mark corpse as searched/looted
    if hover_corpse_loot_quickloot and hover_corpse_loot_quickloot.trigger_corpse_searched_callbacks then
        hover_corpse_loot_quickloot.trigger_corpse_searched_callbacks(npc)
    end

    local target_npc_id = ui.target_id
    local prev_sel_idx  = ui.selected_idx

    hcl_log(2, "action_disassemble_selected", string.format("Calling item_parts.func_disassembly on %s (id=%d, sweep=%s)", obj:section(), obj:id(), tostring(is_sweep)))

    -- Execute native disassembly (runs all GAMMA/WPO monkey-patches, tool checks, and PDA messages)
    item_parts.func_disassembly(obj)

    -- Schedule a lightweight check to refresh the Hover UI once the disassembly timer releases the item
    CreateTimeEvent("hcl_disassemble_refresh", "hcl_dis_ref_" .. tostring(obj:id()), 0.15, function()
        local active_ui = hover_corpse_loot_ui and hover_corpse_loot_ui.get_ui()
        if active_ui and active_ui:IsShown() and active_ui.target_id == target_npc_id then
            local corpse = level.object_by_id(target_npc_id)
            if corpse then
                if active_ui.selected_idx == nil then
                    active_ui.selected_idx = prev_sel_idx
                end
                active_ui:UpdateCorpseData(corpse, true)
            end
        end
        return true
    end)

    return true
end

---------------------------------------------------------------------------------------
-- Executes the Bidirectional Hold Right Click + Scroll "Row-Sweep Disassemble" action:
-- Disassembles the currently selected item and advances along the current row/category,
-- engaging the rolling safety brake (`row_sweep_lock_t`) when reaching the end of a
-- category/row so the player doesn't accidentally disassemble items in the next row.
-- Arguments: ui (UIHoverCorpseLoot), step (number: 1 = Down/Right, -1 = Up/Left)
-- Returns: (boolean) - True if disassembly was triggered or cursor stepped
---------------------------------------------------------------------------------------
function action_row_sweep_disassemble(ui, step)
    step = step or 1
    local tg = time_global()
    local brake_ms = hover_corpse_loot_mcm.get_config("row_sweep_cooldown") or 450

    -- Rolling Brake: If we just finished sweeping a category/row, block further
    -- RMB+Scroll ticks and refresh the brake timer until the player pauses scrolling!
    if tg < row_sweep_lock_t then
        row_sweep_lock_t = tg + math.min(350, brake_ms)
        hcl_log(2, "action_row_sweep_disassemble", "Row-end rolling brake active; blocking accidental next-row disassemble")
        return false
    end

    if not ui or not ui:IsShown() or not ui.selected_idx or not ui.target_id then
        return false
    end

    local grouped   = ui.current_grouped
    local grid_rows = ui.grid_rows
    if not grouped or #grouped == 0 or not grid_rows then return false end

    local cur_entry = grouped[ui.selected_idx]
    if not cur_entry then return false end

    local cur_r     = cur_entry.nav_row or 1
    local cur_c     = cur_entry.nav_col or 1
    local cur_group = cur_entry.row_group_key
    local row_list  = grid_rows[cur_r]
    local row_len   = row_list and #row_list or 1
    local prev_cnt  = #grouped

    -- Check if there is a continuation row of the SAME category in the sweep direction
    local adj_row_same_group = false
    if step > 0 then
        if cur_r < #grid_rows and grid_rows[cur_r + 1] and grid_rows[cur_r + 1][1] then
            local below_entry = grouped[grid_rows[cur_r + 1][1]]
            if below_entry and below_entry.row_group_key == cur_group then
                adj_row_same_group = true
            end
        end
    else
        if cur_r > 1 and grid_rows[cur_r - 1] and grid_rows[cur_r - 1][1] then
            local above_entry = grouped[grid_rows[cur_r - 1][1]]
            if above_entry and above_entry.row_group_key == cur_group then
                adj_row_same_group = true
            end
        end
    end

    -- Trigger disassembly on the current item
    action_disassemble_selected(ui, true)

    local npc = level.object_by_id(ui.target_id)
    if npc then
        ui:UpdateCorpseData(npc, true)
    end

    local new_rows    = ui.grid_rows
    local new_grouped = ui.current_grouped
    if not new_rows or #new_rows == 0 or not new_grouped or #new_grouped == 0 then
        ui.selected_idx = nil
        return true
    end

    local item_removed_immediately = (#new_grouped < prev_cnt)

    if step > 0 then
        if item_removed_immediately then
            if row_len <= 1 then
                local next_r = math.min(cur_r, #new_rows)
                local target_row = new_rows[next_r]
                ui.selected_idx = (target_row and target_row[1]) or 1
                if not adj_row_same_group then
                    row_sweep_lock_t = tg + brake_ms
                    hcl_log(2, "action_row_sweep_disassemble", string.format("Right-sweep disassemble finished row %d! Engaging %dms brake", cur_r, brake_ms))
                end
            else
                local same_row = new_rows[cur_r]
                if same_row and #same_row > 0 then
                    ui.selected_idx = same_row[math.min(cur_c, #same_row)]
                end
            end
        else
            -- Item removal is pending async timer (or item wasn't disassemblable): advance cursor rightward
            if cur_c < row_len then
                local same_row = new_rows[cur_r]
                if same_row and same_row[cur_c + 1] then
                    ui.selected_idx = same_row[cur_c + 1]
                end
            else
                local next_r = (cur_r < #new_rows) and (cur_r + 1) or 1
                local target_row = new_rows[next_r]
                ui.selected_idx = (target_row and target_row[1]) or 1
                if not adj_row_same_group then
                    row_sweep_lock_t = tg + brake_ms
                    hcl_log(2, "action_row_sweep_disassemble", string.format("Right-sweep disassemble reached end of row %d! Engaging %dms brake", cur_r, brake_ms))
                end
            end
        end
    else
        if cur_c <= 1 then
            local prev_r = (cur_r > 1) and math.min(cur_r - 1, #new_rows) or #new_rows
            local target_row = new_rows[prev_r]
            ui.selected_idx = (target_row and target_row[#target_row]) or 1
            if not adj_row_same_group then
                row_sweep_lock_t = tg + brake_ms
                hcl_log(2, "action_row_sweep_disassemble", string.format("Left-sweep disassemble reached start of row %d! Engaging %dms brake", cur_r, brake_ms))
            end
        else
            local same_row = new_rows[cur_r]
            if same_row and #same_row > 0 then
                ui.selected_idx = same_row[math.min(cur_c - 1, #same_row)]
            end
        end
    end

    if npc then
        ui:UpdateCorpseData(npc, true)
    end
    return true
end


---------------------------------------------------------------------------------------
-- Refreshes the SortingPlus priority cache whenever MCM options change.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_option_change()
    ensure_sortingplus_cache(true)
end

function on_game_start()
    RegisterScriptCallback("on_option_change", on_option_change)
end
