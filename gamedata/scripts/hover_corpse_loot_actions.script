local MACRO_CATEGORY_MAP = {
    w_sniper      = 1,
    w_rifle       = 1,
    w_smg         = 1,
    w_shotgun     = 1,
    w_pistol      = 1,
    w_melee       = 1,
    o_heavy       = 1,
    o_sci         = 1,
    o_medium      = 1,
    o_light       = 1,
    o_helmet      = 1,
    i_backpack    = 1,

    w_ammo        = 2,
    w_explosive   = 2,
    w_misc        = 2,
    i_attach      = 2,
    i_device      = 2,
    mags          = 2,
    loadout       = 2,

    i_medical     = 3,
    i_food        = 3,
    i_drink       = 3,
    i_mutant_raw  = 3,

    i_mutant_belt = 4,
    i_arty        = 4,
    i_arty_junk   = 4,
    i_arty_cont   = 4,
    i_upgrade     = 4,
    i_repair      = 4,
