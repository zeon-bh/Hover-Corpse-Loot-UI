        id = "hover_corpse_loot",
        gr = {
            -- ========================================================================
            -- SUB-TAB 1: UI & OVERLAYS
            -- ========================================================================
            {
                id = "hcl_ui",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_hover_corpse_loot_title", size = {512, 50}, spacing = 20 },

                    { id = "header_general", type = "desc", text = "ui_mcm_hover_corpse_loot_header_general", clr = {255, 215, 185, 140} },
                    { id = "enabled",     type = "check", val = 1, def = DEFAULTS.enabled },
                    { id = "max_dist",    type = "track", val = 2, min = 0.5, max = 3.5, step = 0.1, def = DEFAULTS.max_dist },
                    { id = "hover_delay", type = "track", val = 2, min = 0,   max = 1000, step = 50, def = DEFAULTS.hover_delay },

                    { id = "divider_1", type = "line" },

                    { id = "header_style", type = "desc", text = "ui_mcm_hover_corpse_loot_header_style", clr = {255, 215, 185, 140} },
                    { id = "ui_style", type = "list", val = 2, def = DEFAULTS.ui_style,
                        content = {
                            { 1, "hcl_style_minimal" },
                            { 2, "hcl_style_tactical" },
                            { 3, "hcl_style_compact" },
                        }
                    },
                    { id = "sort_mode", type = "list", val = 2, def = DEFAULTS.sort_mode,
                        content = {
                            { 1, "hcl_sort_classic" },
                            { 2, "hcl_sort_macro" },
                            { 3, "hcl_sort_strict" },
                        }
                    },
                    { id = "looted_style", type = "list", val = 2, def = DEFAULTS.looted_style,
                        content = {
                            { 1, "hcl_ind_paren" },
                            { 2, "hcl_ind_bracket" },
                            { 3, "hcl_ind_check" },
                            { 4, "hcl_ind_plus" },
                            { 5, "hcl_ind_status" },
                        }
                    },

                    { id = "divider_2", type = "line" },

                    { id = "header_utjan", type = "desc", text = "ui_mcm_hover_corpse_loot_header_utjan", clr = {255, 215, 185, 140} },
                    { id = "show_part_dots",   type = "check", val = 1, def = DEFAULTS.show_part_dots },
                    { id = "show_upgr_count",  type = "check", val = 1, def = DEFAULTS.show_upgr_count },
                    { id = "show_cond_text",   type = "check", val = 1, def = DEFAULTS.show_cond_text },
                    { id = "show_repair_icon", type = "check", val = 1, def = DEFAULTS.show_repair_icon },
                    { id = "show_armor_patch", type = "check", val = 1, def = DEFAULTS.show_armor_patch },
                    { id = "show_pda_recipe",  type = "check", val = 1, def = DEFAULTS.show_pda_recipe },
                    { id = "show_ammo_name",   type = "check", val = 1, def = DEFAULTS.show_ammo_name },
                    { id = "show_money_text",  type = "check", val = 1, def = DEFAULTS.show_money_text },
                    { id = "show_stack_count", type = "check", val = 1, def = DEFAULTS.show_stack_count },

                    { id = "divider_3", type = "line" },

                    { id = "header_layout", type = "desc", text = "ui_mcm_hover_corpse_loot_header_layout", clr = {255, 215, 185, 140} },
                    { id = "offset_x",     type = "track", val = 2, min = -450, max = 450, step = 5,  def = DEFAULTS.offset_x },
                    { id = "offset_y",     type = "track", val = 2, min = -350, max = 350, step = 5,  def = DEFAULTS.offset_y },
                    { id = "bg_alpha",     type = "track", val = 2, min = 40,   max = 255, step = 5,  def = DEFAULTS.bg_alpha },
                    { id = "cell_size",    type = "track", val = 2, min = 24,   max = 64,  step = 2,  def = DEFAULTS.cell_size },
                    { id = "grid_cols",    type = "track", val = 2, min = 3,    max = 12,  step = 1,  def = DEFAULTS.grid_cols },
                    { id = "max_rows",     type = "track", val = 2, min = 3,    max = 16,  step = 1,  def = DEFAULTS.max_rows },
                    { id = "show_faction", type = "check", val = 1, def = DEFAULTS.show_faction },
                    { id = "show_subinfo", type = "check", val = 1, def = DEFAULTS.show_subinfo },
                }
            },

            -- ========================================================================
            -- SUB-TAB 2: QUICK-LOOT & CONTROLS
            -- ========================================================================
            {
                id = "hcl_loot",
                sh = true,
                gr = {
                    { id = "ql_title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_hover_corpse_loot_ql_title", size = {512, 50}, spacing = 20 },

                    { id = "header_ql_gen", type = "desc", text = "ui_mcm_hover_corpse_loot_header_ql_gen", clr = {255, 215, 185, 140} },
                    { id = "ql_enabled", type = "check", val = 1, def = DEFAULTS.ql_enabled },
                    { id = "sel_color",  type = "list",  val = 2, def = DEFAULTS.sel_color,
                        content = {
                            { 1, "hcl_clr_amber" },
                            { 2, "hcl_clr_green" },
                            { 3, "hcl_clr_white" },
                            { 4, "hcl_clr_cyan" },
                            { 5, "hcl_clr_red" },
                        }
                    },
                    { id = "sel_brightness", type = "track", val = 2, min = 0.1, max = 2.0, step = 0.1, def = DEFAULTS.sel_brightness },
                    { id = "wheel_mode", type = "list", val = 2, def = DEFAULTS.wheel_mode,
                        content = {
                            { 1, "hcl_wheel_notch" },
                            { 2, "hcl_wheel_gesture" },
                        }
                    },
                    { id = "wheel_cooldown",     type = "track", val = 2, min = 50, max = 500, step = 10, def = DEFAULTS.wheel_cooldown },
                    { id = "swap_scroll_axis",   type = "check", val = 1, def = DEFAULTS.swap_scroll_axis },
                    { id = "reset_col_on_row",   type = "check", val = 1, def = DEFAULTS.reset_col_on_row },
                    { id = "row_sweep_cooldown", type = "track", val = 2, min = 150, max = 1000, step = 50, def = DEFAULTS.row_sweep_cooldown },
                    { id = "sweep_vel_mult",     type = "track", val = 2, min = 0.0, max = 2.0, step = 0.1, def = DEFAULTS.sweep_vel_mult },
                    { id = "sweep_disassemble",  type = "check", val = 1, def = DEFAULTS.sweep_disassemble },
                    { id = "stack_mode", type = "list", val = 2, def = DEFAULTS.stack_mode,
                        content = {
                            { 1, "hcl_stack_all" },
                            { 2, "hcl_stack_one" },
                        }
                    },
                    { id = "strip_min_cond",    type = "track", val = 2, min = 0, max = 100, step = 5, def = DEFAULTS.strip_min_cond },
                    { id = "strip_attachments", type = "check", val = 1, def = DEFAULTS.strip_attachments },
                    { id = "fdda_anim",         type = "check", val = 1, def = DEFAULTS.fdda_anim },
                    { id = "show_footer",    type = "check", val = 1, def = DEFAULTS.show_footer },

                    { id = "divider_ql", type = "line" },

                    { id = "header_ql_binds", type = "desc", text = "ui_mcm_hover_corpse_loot_header_ql_binds", clr = {255, 215, 185, 140} },
                    { id = "key_modifier",    type = "key_bind", val = 2, def = DEFAULTS.key_modifier },
                }
            },
        }
    }
    return op
end

---------------------------------------------------------------------------------------
-- Callback fired when the player closes the MCM menu and applies changes.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_option_change()
    refresh_settings()
    if hover_corpse_loot_ui and hover_corpse_loot_ui.on_settings_changed then
        hover_corpse_loot_ui.on_settings_changed()
    end
end

---------------------------------------------------------------------------------------
-- Initializes settings and registers the MCM option change callback on game start.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_game_start()
    refresh_settings()
    RegisterScriptCallback("on_option_change", on_option_change)
end
