                    { id = "sel_color",  type = "list",  val = 2, def = DEFAULTS.sel_color,
                        content = {
                            { 1, "hcl_clr_amber" },
                            { 2, "hcl_clr_green" },
                            { 3, "hcl_clr_white" },
                            { 4, "hcl_clr_cyan" },
                            { 5, "hcl_clr_red" },
