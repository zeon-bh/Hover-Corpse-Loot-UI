--[[
=======================================================================================
    Hover Corpse Loot UI - Module 1: MCM Configuration Manager
    File: hover_corpse_loot_mcm.script
    Description: Defines default configuration settings, builds the two-tab MCM menu
                 (UI & Overlays + Quick-Loot & Controls), and provides fast getters.
=======================================================================================
--]]

-- Default fallback settings
local DEFAULTS = {
    -- Sub-Tab 1: UI & Overlays (hcl_ui)
    enabled          = true,
    max_dist         = 2.8,
    hover_delay      = 150,
    ui_style         = 2,     -- 1 = Minimal, 2 = Tactical, 3 = Compact
    sort_mode        = 2,     -- 1 = Classic Size, 2 = Macro-Category Rows, 3 = Strict Kind Rows
    looted_style     = 1,     -- 1 = (Looted), 2 = [LOOTED], 3 = [v], 4 = [+], 5 = [UNSEARCHED]/[LOOTED]
    show_part_dots   = true,
    show_upgr_count  = true,  -- Show Golden Circle Upgrade Count Badge at Top-Left
    show_cond_text   = true,
    show_repair_icon = false,
    show_armor_patch = false,
    show_pda_recipe  = true,
    show_ammo_name   = false,
    show_money_text  = false,
    show_stack_count = false,
    offset_x         = 45,
    offset_y         = -30,
    bg_alpha         = 190,
    cell_size        = 38,
    grid_cols        = 6,
    max_rows         = 8,     -- Max visible vertical rows before viewport scrolling engages
    show_faction     = true,
    show_subinfo     = true,  

    -- Sub-Tab 2: Quick-Loot & Controls (hcl_loot)
    ql_enabled         = true,
    sel_color          = 3,     -- 1 = Amber/Gold, 2 = Green, 3 = White, 4 = Cyan, 5 = Red
    sel_brightness     = 1.0,   -- Brightness multiplier for the flat selection highlight (0.5 to 2.0)
    wheel_mode         = 1,     -- 1 = Per Notch/Click, 2 = Per Scroll Gesture (Debounced)
    wheel_cooldown     = 160,   -- Cooldown in ms for Gesture mode (prevents hyper-scroll skipping)
    stack_mode         = 1,     -- 1 = Take Entire Stack, 2 = Take Single Item
    fdda_anim          = true,  -- Play FDDA body search animation when selection starts
    show_footer        = true,  -- Show persistent bottom footer bar for selected item name
    swap_scroll_axis   = false,               -- false = Normal Scroll moves Rows (Mod moves Cols); true = Swapped!
    key_modifier       = DIK_keys.DIK_LMENU,  -- Single Unified Modifier Key (Default: Left Alt)
    sweep_disassemble  = false,               -- Hold Right Click + Scroll to Sweep-Disassemble Row (Default: OFF)
    row_sweep_cooldown = 450,                 -- Safety brake (ms) when a row finishes sweeping
    sweep_vel_mult     = 0.5,                 -- Dynamic Scroll Velocity Multiplier (0.0 = Off/1:1 Only, 0.5 = Default, up to 2.0x)
    reset_col_on_row   = true,                -- Reset selection to 1st column when scrolling Up/Down between rows
    strip_min_cond     = 60,                  -- Minimum part condition % to field-strip (Default: 60%)
    strip_attachments  = true,                -- Strip attached Scopes & Silencers into player inventory on Field Strip (Default: ON)
}


-- Maps each setting key to its MCM sub-tab ID ("hcl_ui" or "hcl_loot")
local KEY_TAB_MAP = {
    ql_enabled         = "hcl_loot",
    sel_color          = "hcl_loot",
    sel_brightness     = "hcl_loot",
    wheel_mode         = "hcl_loot",
    wheel_cooldown     = "hcl_loot",
    swap_scroll_axis   = "hcl_loot",
    reset_col_on_row   = "hcl_loot",
    row_sweep_cooldown = "hcl_loot",
    sweep_vel_mult     = "hcl_loot",
    key_modifier       = "hcl_loot",
    sweep_disassemble  = "hcl_loot",
    stack_mode         = "hcl_loot",
    strip_min_cond     = "hcl_loot",
    strip_attachments  = "hcl_loot",
    fdda_anim          = "hcl_loot",
    show_footer        = "hcl_loot",
}

local active_settings = {}

---------------------------------------------------------------------------------------
-- Copies default values into active_settings and syncs with ui_mcm if available.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function refresh_settings()
    for k, v in pairs(DEFAULTS) do
        if ui_mcm then
            local tab = KEY_TAB_MAP[k] or "hcl_ui"
            local mcm_val = ui_mcm.get("hover_corpse_loot/" .. tab .. "/" .. k)
            if mcm_val ~= nil then
                active_settings[k] = mcm_val
            else
                active_settings[k] = v
            end
        else
            active_settings[k] = v
        end
    end
end

---------------------------------------------------------------------------------------
-- Retrieves a specific configuration setting by key name.
-- Arguments: key (string) - The setting key from DEFAULTS
-- Returns: (any) - The current value of the setting, or the default fallback
---------------------------------------------------------------------------------------
function get_config(key)
    if active_settings[key] == nil then
        refresh_settings()
    end
    return active_settings[key]
end

---------------------------------------------------------------------------------------
-- Builds the two-tab MCM options tree (Tab 1: UI & Overlays, Tab 2: Quick-Loot).
-- Arguments: None
-- Returns: op (table) - The MCM options tree table
---------------------------------------------------------------------------------------
