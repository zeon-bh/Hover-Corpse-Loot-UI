--[[
=======================================================================================
    Hover Corpse Loot UI - Module 1: MCM Configuration Manager
    File: hover_corpse_loot_mcm.script
    Description: Defines default configuration settings, builds the MCM (Mod Configuration
                 Menu) tree, and provides safe getter functions for other modules.
=======================================================================================
--]]

-- Default fallback settings (used if MCM is not installed or before MCM loads)
local DEFAULTS = {
    enabled          = true,
    max_dist         = 2.8,   -- Default 2.8m (Matches Anomaly's native 'F' corpse interaction distance)
    hover_delay      = 200,   -- 200 milliseconds hover delay before showing UI
    ui_style         = 2,     -- 1 = Minimal, 2 = Tactical, 3 = Compact
    looted_style     = 1,     -- 1 = (Looted), 2 = [LOOTED], 3 = [v], 4 = [+], 5 = [UNSEARCHED]/[LOOTED]

    -- Utjan Item Cell Indicator Toggles (Let players customize how minimal or detailed icons are)
    show_part_dots   = true,  -- Weapon & Armor part condition dots
    show_cond_text   = false, -- Overall item condition percentage (e.g. "48%")
    show_repair_icon = false, -- Weapon & Armor repair kit type icon badge
    show_armor_patch = false, -- Outfit faction patch mini-badge
    show_pda_recipe  = true,  -- "(???)" on PDAs with stashes & "(new!)" on unread recipes
    show_ammo_name   = false, -- Short ammo caliber/type text
    show_money_text  = false, -- Ruble value on cash stacks
    show_stack_count = false, -- Stack quantity counter (e.g. "x16")

    -- Window Layout & Position Tweaks
    offset_x         = 45,    -- Pixels to the right of screen center (crosshair)
    offset_y         = -30,   -- Pixels above/below screen center (crosshair)
    bg_alpha         = 190,   -- Background darkness/opacity (0-255)
    cell_size        = 38,    -- Size of each grid cell in pixels
    grid_cols        = 6,     -- Number of columns in the item grid
    show_faction     = true,  -- Show Faction Patch icon in header
    show_rank        = true,  -- Show Rank Chevron icon in header
    show_subinfo     = true,  -- Show "Rank - Faction" subtitle text in header
}

-- Cached active settings table for fast lookup inside actor_on_update
local active_settings = {}

---------------------------------------------------------------------------------------
-- Copies default values into active_settings and syncs with ui_mcm if available.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function refresh_settings()
    for k, v in pairs(DEFAULTS) do
        if ui_mcm then
            local mcm_val = ui_mcm.get("hover_corpse_loot/" .. k)
            if mcm_val ~= nil then
                active_settings[k] = mcm_val
            else
                active_settings[k] = v
            end
        else
            active_settings[k] = v
        end
    end
end

---------------------------------------------------------------------------------------
-- Retrieves a specific configuration setting by key name.
-- Arguments: key (string) - The setting key from DEFAULTS
-- Returns: (any) - The current value of the setting, or the default fallback
---------------------------------------------------------------------------------------
function get_config(key)
    if active_settings[key] == nil then
        refresh_settings()
    end
    return active_settings[key]
end

---------------------------------------------------------------------------------------
-- Callback triggered automatically by Anomaly's MCM script when building the menu UI.
-- Defines sliders, checkboxes, and dropdowns for player customization.
-- Arguments: None
-- Returns: op (table) - The MCM options tree table
---------------------------------------------------------------------------------------
function on_mcm_load()
    local op = {
        id = "hover_corpse_loot",
        sh = true,
        gr = {
            -- Title Banner
            { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_hover_corpse_loot_title", size = {512, 50}, spacing = 20 },

            -- Section 1: General & Trigger Settings
            { id = "header_general", type = "desc", text = "ui_mcm_hover_corpse_loot_header_general", clr = {255, 215, 185, 140} },
            { id = "enabled",     type = "check", val = 1, def = DEFAULTS.enabled },
            { id = "max_dist",    type = "track", val = 2, min = 0.5, max = 3.5, step = 0.1, def = DEFAULTS.max_dist },
            { id = "hover_delay", type = "track", val = 2, min = 0,   max = 1000, step = 50, def = DEFAULTS.hover_delay },

            { id = "divider_1", type = "line" },

            -- Section 2: UI Style & Looted Indicator
            { id = "header_style", type = "desc", text = "ui_mcm_hover_corpse_loot_header_style", clr = {255, 215, 185, 140} },
            { id = "ui_style", type = "list", val = 2, def = DEFAULTS.ui_style,
                content = {
                    { 1, "hcl_style_minimal" },
                    { 2, "hcl_style_tactical" },
                    { 3, "hcl_style_compact" },
                }
            },
            { id = "looted_style", type = "list", val = 2, def = DEFAULTS.looted_style,
                content = {
                    { 1, "hcl_ind_paren" },
                    { 2, "hcl_ind_bracket" },
                    { 3, "hcl_ind_check" },
                    { 4, "hcl_ind_plus" },
                    { 5, "hcl_ind_status" },
                }
            },

            { id = "divider_2", type = "line" },

            -- Section 3: Utjan Item Cell Overlays
            { id = "header_utjan", type = "desc", text = "ui_mcm_hover_corpse_loot_header_utjan", clr = {255, 215, 185, 140} },
            { id = "show_part_dots",   type = "check", val = 1, def = DEFAULTS.show_part_dots },
            { id = "show_cond_text",   type = "check", val = 1, def = DEFAULTS.show_cond_text },
            { id = "show_repair_icon", type = "check", val = 1, def = DEFAULTS.show_repair_icon },
            { id = "show_armor_patch", type = "check", val = 1, def = DEFAULTS.show_armor_patch },
            { id = "show_pda_recipe",  type = "check", val = 1, def = DEFAULTS.show_pda_recipe },
            { id = "show_ammo_name",   type = "check", val = 1, def = DEFAULTS.show_ammo_name },
            { id = "show_money_text",  type = "check", val = 1, def = DEFAULTS.show_money_text },
            { id = "show_stack_count", type = "check", val = 1, def = DEFAULTS.show_stack_count },

            { id = "divider_3", type = "line" },

            -- Section 4: UI Position & Element Tweaks
            { id = "header_layout", type = "desc", text = "ui_mcm_hover_corpse_loot_header_layout", clr = {255, 215, 185, 140} },
            { id = "offset_x",     type = "track", val = 2, min = -450, max = 450, step = 5,  def = DEFAULTS.offset_x },
            { id = "offset_y",     type = "track", val = 2, min = -350, max = 350, step = 5,  def = DEFAULTS.offset_y },
            { id = "bg_alpha",     type = "track", val = 2, min = 40,   max = 255, step = 5,  def = DEFAULTS.bg_alpha },
            { id = "cell_size",    type = "track", val = 2, min = 24,   max = 64,  step = 2,  def = DEFAULTS.cell_size },
            { id = "grid_cols",    type = "track", val = 2, min = 3,    max = 12,  step = 1,  def = DEFAULTS.grid_cols },
            { id = "show_faction", type = "check", val = 1, def = DEFAULTS.show_faction },
            { id = "show_rank",    type = "check", val = 1, def = DEFAULTS.show_rank },
            { id = "show_subinfo", type = "check", val = 1, def = DEFAULTS.show_subinfo },
        }
    }
    return op
end

---------------------------------------------------------------------------------------
-- Callback fired when the player closes the MCM menu and applies changes.
-- Refreshes our cached settings and forces the UI window to rebuild its layout.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_option_change()
    refresh_settings()
    if hover_corpse_loot_ui and hover_corpse_loot_ui.on_settings_changed then
        hover_corpse_loot_ui.on_settings_changed()
    end
end

---------------------------------------------------------------------------------------
-- Initializes settings and registers the MCM option change callback on game start.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_game_start()
    refresh_settings()
    RegisterScriptCallback("on_option_change", on_option_change)
end