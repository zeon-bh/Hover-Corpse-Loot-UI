                            { 1, "mcm_kb_mod_shift" },
                            { 2, "mcm_kb_mod_ctrl" },
                            { 3, "mcm_kb_mod_alt" },
                        }
                    },
                    { id = "row_sweep_cooldown", type = "track", val = 2, min = 150, max = 1000, step = 50, def = DEFAULTS.row_sweep_cooldown },
                    { id = "stack_mode", type = "list", val = 2, def = DEFAULTS.stack_mode,
                        content = {
                            { 1, "hcl_stack_all" },
                            { 2, "hcl_stack_one" },
                        }
                    },
                    { id = "fdda_anim", type = "check", val = 1, def = DEFAULTS.fdda_anim },
                    
                    { id = "show_footer", type = "check", val = 1, def = DEFAULTS.show_footer },

                    { id = "divider_ql", type = "line" },

                    { id = "header_ql_binds", type = "desc", text = "ui_mcm_hover_corpse_loot_header_ql_binds", clr = {255, 215, 185, 140} },
                    { id = "key_take",     type = "key_bind", val = 2, def = DEFAULTS.key_take },
                    { id = "mod_take",     type = ui_mcm.kb_mod_radio, val = 2, def = DEFAULTS.mod_take, hint = "mcm_kb_modifier",
                        content = {
                            { 0, "mcm_kb_mod_none" },
                            { 1, "mcm_kb_mod_shift" },
                            { 2, "mcm_kb_mod_ctrl" },
                            { 3, "mcm_kb_mod_alt" },
                        }
                    },
                    { id = "key_take_all", type = "key_bind", val = 2, def = DEFAULTS.key_take_all },
                    { id = "mod_take_all", type = ui_mcm.kb_mod_radio, val = 2, def = DEFAULTS.mod_take_all, hint = "mcm_kb_modifier",
                        content = {
                            { 0, "mcm_kb_mod_none" },
                            { 1, "mcm_kb_mod_shift" },
