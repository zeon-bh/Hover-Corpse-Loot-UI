end

---------------------------------------------------------------------------------------
-- Callback fired when the player closes the MCM menu and applies changes.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_option_change()
    refresh_settings()
    if hover_corpse_loot_ui and hover_corpse_loot_ui.on_settings_changed then
        hover_corpse_loot_ui.on_settings_changed()
    end
end

---------------------------------------------------------------------------------------
-- Initializes settings and registers the MCM option change callback on game start.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_game_start()
    refresh_settings()
    RegisterScriptCallback("on_option_change", on_option_change)
end