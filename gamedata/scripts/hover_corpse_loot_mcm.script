                    },
                    { id = "sel_brightness", type = "track", val = 2, min = 0.1, max = 2.0, step = 0.1, def = DEFAULTS.sel_brightness },
                    { id = "wheel_mode", type = "list", val = 2, def = DEFAULTS.wheel_mode,
                        content = {
