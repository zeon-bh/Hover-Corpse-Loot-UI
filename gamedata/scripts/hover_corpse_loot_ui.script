-- Singleton HUD instance reference
local hud_ui = nil

---------------------------------------------------------------------------------------
-- Returns or initializes the singleton UIHoverCorpseLoot HUD window instance.
-- Arguments: None
-- Returns: (UIHoverCorpseLoot) - The active HUD UI instance
---------------------------------------------------------------------------------------
function get_ui()
    if not hud_ui then
        hud_ui = UIHoverCorpseLoot()
    end
    return hud_ui
end

---------------------------------------------------------------------------------------
-- Called by hover_corpse_loot_mcm when MCM settings are changed by the player.
-- Destroys and recreates the singleton UI so all layout/size changes apply cleanly.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_settings_changed()
    if hud_ui then
        hud_ui:Hide()
        hud_ui = nil
    end
end

---------------------------------------------------------------------------------------
-- Called by hover_corpse_loot_tracker when the player presses 'F' on a corpse.
-- If the UI is currently showing that corpse, refreshes its header to show (Looted).
-- Arguments: npc_id (number) - The ID of the corpse that was just interacted with
-- Returns: None
---------------------------------------------------------------------------------------
function refresh_if_target(npc_id)
    if hud_ui and hud_ui.target_id == npc_id then
        local npc = level.object_by_id(npc_id)
        if npc then
            hud_ui:UpdateCorpseData(npc, true)
        end
    end
end

---------------------------------------------------------------------------------------
-- Destroys the HUD instance cleanly when the actor/level net_destroy fires.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function actor_on_net_destroy()
    if hud_ui then
        hud_ui:Hide()
        hud_ui = nil
    end
end

-- ====================================================================================
-- CLASS: UIHoverCorpseLoot
-- ====================================================================================
class "UIHoverCorpseLoot" (CUIScriptWnd)

---------------------------------------------------------------------------------------
-- Constructor for the Hover Corpse Loot UI window.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:__init() super()
    self.target_id             = nil
    self.last_item_count       = -1
    self.last_looted_st        = nil
    self.selected_idx          = nil -- nil by default until mouse wheel is scrolled!
    self.last_active_corpse_id = nil -- Remembers the SINGLE last corpse ID being looted
    self.last_active_sel_idx   = nil -- Remembers the cursor index if player looks away & returns to SAME corpse
    self.view_start_r          = 0   -- Top visible 0-indexed grid row for vertical viewport scrolling
    self.current_grouped       = {}  -- Stores current grouped items for quick-loot module
    self.grid_rows             = {}  -- Stores 2D row navigation matrix
    self.cell_pool             = {}  -- Pool of reusable UI cell widgets
    self.is_claimed            = false
    self:InitControls()
end

---------------------------------------------------------------------------------------
-- Destructor for UIHoverCorpseLoot.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:__finalize()
end

---------------------------------------------------------------------------------------
-- Parses `ui_hover_corpse_loot.xml` (and `ui_utjan_icon_info.xml` if available)
-- and initializes all background, header, and grid container widgets.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)

    self.xml = CScriptXmlInit()
    self.xml:ParseFile("ui_hover_corpse_loot.xml")

    if z_item_icon_info and z_item_icon_info.utjan_xml then
        self.utjan_xml = z_item_icon_info.utjan_xml
    else
        self.utjan_xml = CScriptXmlInit()
        self.utjan_xml:ParseFile("ui_utjan_icon_info.xml")
    end

    self.frame          = self.xml:InitStatic("hover_loot_frame", self)
    self.border_frame   = self.xml:InitStatic("hover_loot_frame:border_frame", self.frame)
    self.bg_frame       = self.xml:InitStatic("hover_loot_frame:bg_frame", self.frame)
    self.header_bg      = self.xml:InitStatic("hover_loot_frame:header_bg", self.frame)
    self.header_line    = self.xml:InitStatic("hover_loot_frame:header_line", self.frame)

    self.faction_holder = self.xml:InitStatic("hover_loot_frame:faction_holder", self.frame)
    self.faction_icon   = self.xml:InitStatic("hover_loot_frame:faction_icon", self.frame)
    self.npc_name       = self.xml:InitTextWnd("hover_loot_frame:npc_name", self.frame)
    self.npc_subinfo    = self.xml:InitTextWnd("hover_loot_frame:npc_subinfo", self.frame)
    self.looted_status  = self.xml:InitTextWnd("hover_loot_frame:looted_status", self.frame)
    self.empty_label    = self.xml:InitTextWnd("hover_loot_frame:empty_label", self.frame)
    self.empty_label:SetText(game.translate_string("st_hcl_empty"))

    self.grid_container = self.xml:InitStatic("hover_loot_frame:grid_container", self.frame)

    -- Tactical Vertical Scrollbar Track & Thumb (Shown only when rows exceed max_rows)
    self.scroll_track   = self.xml:InitStatic("hover_loot_frame:header_bg", self.frame)
    self.scroll_thumb   = self.xml:InitStatic("hover_loot_frame:header_line", self.frame)
    self.scroll_track:Show(false)
    self.scroll_thumb:Show(false)

    -- Persistent Footer Bar Widgets
    self.footer_bg   = self.xml:InitStatic("hover_loot_frame:header_bg", self.frame)
    self.footer_line = self.xml:InitStatic("hover_loot_frame:header_line", self.frame)
    self.footer_text = self.xml:InitTextWnd("hover_loot_frame:npc_subinfo", self.frame)
    self.footer_text:SetTextAlignment(2) -- Center-aligned item name
    self.footer_text:SetEllipsis(true)   -- Cleanly truncates with "..." if name is super long

    self.frame:Show(false)
    self:Show(true)
end

---------------------------------------------------------------------------------------
-- Configures the bottom-right "(Looted)" indicator text and color based on MCM settings.
-- Arguments: is_looted (boolean) - Whether the corpse has been searched
-- Returns: status_str (string) - The plain text shown in the bottom-right indicator
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:UpdateLootedStatusWidget(is_looted)
    local style = hover_corpse_loot_mcm.get_config("looted_style")

    if style == 5 then
        if is_looted then
            local txt = game.translate_string("st_hcl_looted_bracket")
            self.looted_status:SetText(txt)
            self.looted_status:SetTextColor(GetARGB(255, 50, 255, 50))
            self.looted_status:Show(true)
            return txt
        else
            local txt = game.translate_string("st_hcl_unsearched")
            self.looted_status:SetText(txt)
            self.looted_status:SetTextColor(GetARGB(255, 255, 190, 50))
            self.looted_status:Show(true)
            return txt
        end
    end

    if not is_looted then
        self.looted_status:SetText("")
        self.looted_status:Show(false)
        return ""
    end

    local txt = ""
    if style == 1 then
        txt = game.translate_string("st_hcl_looted_paren")
    elseif style == 2 then
        txt = game.translate_string("st_hcl_looted_bracket")
    elseif style == 3 then
        txt = "[v]"
    elseif style == 4 then
        txt = "[+]"
    end

    self.looted_status:SetText(txt)
    self.looted_status:SetTextColor(GetARGB(255, 50, 255, 50))
    self.looted_status:Show(true)
    return txt
end

---------------------------------------------------------------------------------------
-- Inspects a dead NPC's section, profile name, and community to determine their
-- true faction and whether they hold a special camp role (Trader, Mechanic, or Medic).
-- Arguments: npc (game_object) - The dead stalker game object
-- Returns: community (string) - Raw community ID (e.g., "dolg", "stalker", "trader")
--          role_id (string or nil) - Special role key ("trader", "mechanic", "medic", or nil)
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:ResolveCorpseIdentity(npc)
    local community = character_community(npc) or "stalker"
    local sec       = npc:section() or ""
    local profile   = (npc.profile_name and npc:profile_name()) or ""
    local name_id   = npc:name() or ""

    -- Combine lowercase identifiers to check role naming conventions used across GAMMA/Anomaly
    local ident_str = string.lower(sec .. " " .. profile .. " " .. name_id)
    local role_id   = nil

    if string.find(ident_str, "mechanic")
       or string.find(ident_str, "_tech")
       or string.find(ident_str, "tech_")
       or string.find(ident_str, "technik") then
        role_id = "mechanic"
    elseif string.find(ident_str, "medic")
       or string.find(ident_str, "_med_")
       or string.find(ident_str, "doctor") then
        role_id = "medic"
    elseif community == "trader"
       or string.find(ident_str, "trader")
       or string.find(ident_str, "barmen")
       or string.find(ident_str, "barman")
       or string.find(ident_str, "sidorovich")
       or string.find(ident_str, "loris")
       or string.find(ident_str, "spore")
       or string.find(ident_str, "butcher") then
        role_id = "trader"
    end

    hcl_log(3, "ResolveCorpseIdentity", string.format("id=%s sec=%s comm=%s role=%s", tostring(npc:id()), sec, community, tostring(role_id)))
    return community, role_id
end

---------------------------------------------------------------------------------------
-- Resolves and applies the Faction Patch icon (or custom Trader patch if enabled).
-- Mechanics and Medics retain their vanilla faction patch. Independent "trader"
-- community NPCs leave the patch area blank unless USE_CUSTOM_TRADER_PATCH_DDS is true.
-- Arguments: npc (game_object), cursor_x (number), header_h (number), aspect (number)
-- Returns: has_faction (boolean), community (string), rank_name (string), role_id (string|nil)
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:SetupHeaderIcons(npc, cursor_x, header_h, aspect)
    local ui_style     = hover_corpse_loot_mcm.get_config("ui_style")
    local show_faction = hover_corpse_loot_mcm.get_config("show_faction") and (ui_style ~= 1)

    local community, role_id = self:ResolveCorpseIdentity(npc)
    local rank_name          = ranks.get_obj_rank_name(npc) or "novice"
    local patch_sec          = FACTION_PATCH_SECTIONS[community]

    if show_faction then
        local fw = UI_METRICS.faction_w * aspect
        local fh = UI_METRICS.faction_h
        local fy = ((header_h - fh) / 2) + UI_METRICS.faction_y_offset

        if patch_sec and ini_sys:section_exist(patch_sec) then
            -- Standard Faction Patch (includes Faction Mechanics, Medics, and Faction Traders)
            self.faction_holder:SetWndPos(vector2():set(cursor_x, fy))
            self.faction_holder:SetWndSize(vector2():set(fw, fh))
            self.faction_icon:SetWndPos(vector2():set(cursor_x, fy))
            self.faction_icon:SetWndSize(vector2():set(fw, fh))

            utils_xml.set_icon(patch_sec, false, self.faction_holder, self.faction_icon)
            self.faction_icon:Show(true)

        elseif community == "trader" and USE_CUSTOM_TRADER_PATCH_DDS then
            -- Optional Custom Trader .dds Patch (loaded from gamedata\textures\ui\ui_hcl_trader_patch.dds)
            self.faction_icon:InitTexture(CUSTOM_TRADER_PATCH_TEXTURE)
            self.faction_icon:SetStretchTexture(true)
            self.faction_icon:SetWndPos(vector2():set(cursor_x, fy))
            self.faction_icon:SetWndSize(vector2():set(fw, fh))
            self.faction_icon:Show(true)
        else
            -- Independent Trader with no custom .dds: leave patch blank and shift text cleanly left
            show_faction = false
            self.faction_icon:Show(false)
        end
    else
        self.faction_icon:Show(false)
    end

    return show_faction, community, rank_name, role_id
end

---------------------------------------------------------------------------------------
-- Fast helper to count raw lootable items in a corpse's inventory.
-- Arguments: npc (game_object) - The dead stalker game object
-- Returns: count (number), raw_items (table)
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:GetRawCorpseItems(npc)
    local raw_items = {}
    local function itr(temp, item)
        if item then
            local sec = item:section()
            if sec and ini_sys:section_exist(sec)
               and not SYS_GetParam(1, sec, "quest_item", false)
               and sec ~= "bolt"
               and sec ~= "device_torch_dummy"
               and not string.find(sec, "^mp_")
               and not string.find(sec, "anim_") then
                raw_items[#raw_items + 1] = item
            end
        end
    end
    npc:iterate_inventory(itr, nil)
    return #raw_items, raw_items
end

---------------------------------------------------------------------------------------
-- Groups and stacks raw lootable items inside the corpse's inventory.
-- Non-stackable equipment, weapon/armor parts, and degradable items (like glowsticks)
-- are kept as individual entries so each item displays its own accurate condition %.
-- Arguments: raw_items (table) - Array of raw game_object items
-- Returns: grouped (table) - Array of structured item data tables
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:GroupCorpseItems(raw_items)
    local grouped = {}
    local group_map = {}

    for i = 1, #raw_items do
        local itm = raw_items[i]
        local sec = itm:section()
        local is_ammo  = IsAmmo(itm)
        local is_mag   = magazine_binder and magazine_binder.is_magazine(sec)
        local is_multi = IsItem("multiuse", sec)

        -- Treat weapons, armor, headgear, weapon/armor parts, and single-use degradables
        -- (e.g. glowsticks) as individual unstacked items so their condition % is preserved
        local is_part  = SYS_GetParam(1, sec, "cond_part", false)
                         or (string.find(sec, "^prt_w_") ~= nil)
                         or (string.find(sec, "^prt_o_") ~= nil)
        local is_deg   = (not is_ammo) and (not is_mag) and (not is_multi)
                         and (is_part or utils_item.is_degradable(itm, sec) or SYS_GetParam(1, sec, "use_condition", false))
        local is_equip = IsWeapon(itm) or IsOutfit(itm) or IsHeadgear(itm) or is_deg

        local count_val = is_ammo and itm:ammo_get_count() or 1

        if not is_equip and group_map[sec] then
            local entry = grouped[group_map[sec]]
            entry.count = entry.count + count_val
            entry.raw_list[#entry.raw_list + 1] = itm
        else
            local inv_w = SYS_GetParam(2, sec, "inv_grid_width", 1)
            local inv_h = SYS_GetParam(2, sec, "inv_grid_height", 1)
            local entry = {
                item     = itm,
                raw_list = { itm },
                sec      = sec,
                inv_w    = math.max(1, inv_w),
                inv_h    = math.max(1, inv_h),
                area     = inv_w * inv_h,
                count    = count_val,
                is_ammo  = is_ammo,
                is_equip = is_equip,
                cond     = itm:condition(),
            }
            grouped[#grouped + 1] = entry
            if not is_equip then
                group_map[sec] = #grouped
            end
        end
    end

    table.sort(grouped, function(a, b)
        if a.area ~= b.area then
            return a.area > b.area
        end
        return a.sec < b.sec
    end)

    return grouped
end

---------------------------------------------------------------------------------------
-- Helper to size a Utjan text label and optional dark backing rectangle neatly.
-- Arguments: txt_wnd (CUITextWnd), bg_wnd (CUIStatic), str (string), clr (number)
-- Returns: w (number), h (number)
---------------------------------------------------------------------------------------
local function set_utjan_badge_text(txt_wnd, bg_wnd, str, clr)
    txt_wnd:SetText(str)
    if clr then
        txt_wnd:SetTextColor(clr)
    end
    txt_wnd:AdjustHeightToText()
    txt_wnd:AdjustWidthToText()
    local w = txt_wnd:GetWidth() + 3
    local h = txt_wnd:GetHeight() + 1
    txt_wnd:SetWndRect(Frect():set(0, 0, w, h))
    if bg_wnd then
        bg_wnd:SetWndRect(Frect():set(0, 0, w, h))
    end
    return w, h
end


---------------------------------------------------------------------------------------
-- Helper to read an INI parameter from `aaa_rax_icon_override_mcm.icon_override` first
-- (if installed in GAMMA), falling back to `ini_sys` (`SYS_GetParam`).
-- Arguments: typ (number: 0=string, 1=bool, 2=num), sec (string), param (string), def (any)
-- Returns: (any) - Parameter value
---------------------------------------------------------------------------------------
local function get_icon_param(typ, sec, param, def)
    local rax_ovr = aaa_rax_icon_override_mcm and aaa_rax_icon_override_mcm.icon_override
    if rax_ovr and rax_ovr:section_exist(sec) and rax_ovr:line_exist(sec, param) then
        if typ == 0 then return rax_ovr:r_string_ex(sec, param) or def
        elseif typ == 1 then return rax_ovr:r_bool_ex(sec, param)
        elseif typ == 2 then return rax_ovr:r_float_ex(sec, param) or def end
    end
    return SYS_GetParam(typ, sec, param, def)
end

---------------------------------------------------------------------------------------
-- Renders all static INI icon layers (`1icon_layer`, `2icon_layer`...) AND dynamic
-- attached weapon addons (Scopes, Silencers/Suppressors, Grenade Launchers) onto
-- `cell.icon`. Automatically calculates the composite bounding box of the weapon +
-- all attachments and scales/centers `cell.icon` inside the cell so long suppressors
-- and tall scopes never overflow the cell border or Hover UI window!
-- Arguments: cell (table), data (table), box_w (number), box_h (number), aspect (number)
-- Returns: None
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:RenderItemIconLayers(cell, data, box_w, box_h, aspect)
    if cell.att_layers then
        for i = 1, #cell.att_layers do
            cell.att_layers[i]:Show(false)
        end
    else
        cell.att_layers = {}
    end

    local obj = data.item
    local sec = data.sec
    if not sec then return end

    local base_axis = utils_xml.get_item_axis(sec)
    if type(base_axis) ~= "table" or not base_axis.w or base_axis.w <= 0 or base_axis.h <= 0 then
        return
    end

    -- Collect all valid layers (both INI `Nicon_layer` and dynamic weapon attachments) first
    local layers_to_draw = {}

    local function collect_sub_layer(sub_sec, off_x, off_y, scale)
        if not sub_sec or not ini_sys:section_exist(sub_sec) then return end
        local sub_axis = utils_xml.get_item_axis(sub_sec)
        if type(sub_axis) ~= "table" or not sub_axis.w or sub_axis.w <= 0 or sub_axis.h <= 0 then
            return
        end
        local s = scale or 1.0
        layers_to_draw[#layers_to_draw + 1] = {
            sec   = sub_sec,
            axis  = sub_axis,
            x     = (off_x or 0) * s,
            y     = (off_y or 0) * s,
            w     = sub_axis.w * s,
            h     = sub_axis.h * s,
        }
    end

    -- 1. Static INI Icon Layers (`1icon_layer`, `2icon_layer`, etc.)
    local ii = 1
    while true do
        local layer_sec = get_icon_param(0, sec, ii .. "icon_layer", nil)
        if not layer_sec then break end

        local lx    = get_icon_param(2, sec, ii .. "icon_layer_x", 0)
        local ly    = get_icon_param(2, sec, ii .. "icon_layer_y", 0)
        local l_scl = get_icon_param(2, sec, ii .. "icon_layer_scale", 1.0)
        collect_sub_layer(layer_sec, lx, ly, l_scl)

        ii = ii + 1
        if ii > 12 then break end
    end

    -- 2. Dynamic Weapon Attachments (Scope, Silencer, Grenade Launcher)
    if obj and IsWeapon(obj) then
        local scope_status = get_icon_param(2, sec, "scope_status", 0)
        if scope_status == 2 and utils_item.has_attached_scope(obj) then
            local scope_vect = utils_item.get_attached_scope(obj)
            if scope_vect then
                local scope_sec = SYS_GetParam(0, scope_vect, "scope_name") or scope_vect
                local sx        = get_icon_param(2, sec, "scope_x", nil) or SYS_GetParam(2, scope_vect, "scope_x", 0)
                local sy        = get_icon_param(2, sec, "scope_y", nil) or SYS_GetParam(2, scope_vect, "scope_y", 0)
                collect_sub_layer(scope_sec, sx, sy, 1.0)
            end
        end

        local sil_status = get_icon_param(2, sec, "silencer_status", 0)
        if sil_status == 2 and utils_item.has_attached_silencer(obj) then
            local sil_sec = get_icon_param(0, sec, "silencer_name", nil)
            local sx      = get_icon_param(2, sec, "silencer_x", 0)
            local sy      = get_icon_param(2, sec, "silencer_y", 0)
            collect_sub_layer(sil_sec, sx, sy, 1.0)
        end

        local gl_status = get_icon_param(2, sec, "grenade_launcher_status", 0)
        if gl_status == 2 and utils_item.has_attached_gl(obj) then
            local gl_sec = get_icon_param(0, sec, "grenade_launcher_name", nil)
            local gx     = get_icon_param(2, sec, "grenade_launcher_x", 0)
            local gy     = get_icon_param(2, sec, "grenade_launcher_y", 0)
            collect_sub_layer(gl_sec, gx, gy, 1.0)
        end
    end

    if #layers_to_draw == 0 then return end

    -- 3. Calculate Composite Bounding Box in 50px Atlas Space (Base Icon + All Attachments)
    local min_x, min_y = 0, 0
    local max_x, max_y = base_axis.w, base_axis.h

    for i = 1, #layers_to_draw do
        local l = layers_to_draw[i]
        min_x = math.min(min_x, l.x)
        min_y = math.min(min_y, l.y)
        max_x = math.max(max_x, l.x + l.w)
        max_y = math.max(max_y, l.y + l.h)
    end

    local comp_w = math.max(1, max_x - min_x)
    local comp_h = math.max(1, max_y - min_y)

    -- If attachments extend outside the base weapon bounds, re-fit and re-center `cell.icon`
    -- inside the padded cell box so the entire weapon + attachments stay strictly inside `cell.bg`!
    if min_x < 0 or min_y < 0 or max_x > base_axis.w or max_y > base_axis.h then
        local pad     = 3
        local avail_w = math.max(8, box_w - (pad * 2))
        local avail_h = math.max(8, box_h - (pad * 2))
        local asp     = aspect or (utils_xml.is_widescreen() and 0.8 or 1.0)

        -- Convert composite atlas dimensions to screen aspect space
        local comp_scr_w = comp_w * asp
        local comp_scr_h = comp_h

        local fit_scale = math.min(avail_w / comp_scr_w, avail_h / comp_scr_h)
        local final_comp_w = comp_scr_w * fit_scale
        local final_comp_h = comp_scr_h * fit_scale

        local comp_left = pad + ((avail_w - final_comp_w) * 0.5)
        local comp_top  = pad + ((avail_h - final_comp_h) * 0.5)

        -- Position & size `cell.icon` (the base weapon) within the centered composite bounds
        local base_ico_x = comp_left + ((-min_x) * asp * fit_scale)
        local base_ico_y = comp_top  + ((-min_y) * fit_scale)
        local base_ico_w = base_axis.w * asp * fit_scale
        local base_ico_h = base_axis.h * fit_scale

        cell.icon:SetWndPos(vector2():set(base_ico_x, base_ico_y))
        cell.icon:SetWndSize(vector2():set(base_ico_w, base_ico_h))
    end

    local ico_w = cell.icon:GetWidth()
    local ico_h = cell.icon:GetHeight()
    if ico_w <= 0 or ico_h <= 0 then return end

    local ratio_x = ico_w / base_axis.w
    local ratio_y = ico_h / base_axis.h

    -- 4. Render all collected attachment layers onto `cell.icon`
    for i = 1, #layers_to_draw do
        local l     = layers_to_draw[i]
        local l_wnd = cell.att_layers[i]
        if not l_wnd then
            l_wnd = self.xml:InitStatic("hover_loot_frame:cell_icon", cell.icon)
            cell.att_layers[i] = l_wnd
        end

        l_wnd:InitTexture(utils_xml.get_icons_texture(l.sec))
        l_wnd:SetTextureRect(Frect():set(l.axis.x1, l.axis.y1, l.axis.x2, l.axis.y2))
        l_wnd:SetStretchTexture(true)
        l_wnd:SetWndPos(vector2():set(l.x * ratio_x, l.y * ratio_y))
        l_wnd:SetWndSize(vector2():set(l.w * ratio_x, l.h * ratio_y))
        l_wnd:Show(true)
    end
end

---------------------------------------------------------------------------------------
-- Renders all optional Utjan Item UI Improvement overlays on an item cell based on
-- the player's MCM toggles (Part Dots, Condition %, Repair Type Icon, Armor Patch,
-- PDA/Recipe Tags, Ammo Short Name, Money Text, and Stack Count).
-- Arguments: cell (table), data (table), box_w (number), box_h (number), use_tetris (boolean), aspect (number)
-- Returns: None
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:RenderUtjanOverlays(cell, data, box_w, box_h, use_tetris, aspect)
    -- 1. Hide all overlay widgets on this pooled cell first
    if cell.dots then
        for i = 1, #cell.dots do cell.dots[i]:Show(false) end
    end
    if cell.cond_txt then cell.cond_txt:Show(false) end
    if cell.cond_bg then cell.cond_bg:Show(false) end
    if cell.repair_ico then cell.repair_ico:Show(false) end
    if cell.patch_ico then cell.patch_ico:Show(false) end
    if cell.top_txt then cell.top_txt:Show(false) end
    if cell.top_bg then cell.top_bg:Show(false) end
    if cell.stack_txt then cell.stack_txt:Show(false) end
    if cell.stack_bg then cell.stack_bg:Show(false) end
    if cell.fav_ico then cell.fav_ico:Show(false) end
    if cell.junk_ico then cell.junk_ico:Show(false) end

    local obj = data.item
    local sec = data.sec
    if not obj or not sec then return end

    local clsid  = obj:clsid()
    local is_wpn = IsWeapon(obj, clsid)
    local is_arm = IsOutfit(obj, clsid) or IsHeadgear(obj, clsid)

    -- Lazily initialize Utjan overlay widgets on the cell if needed
    if not cell.cond_txt and self.utjan_xml then
        cell.cond_bg    = self.utjan_xml:InitStatic("background", cell.bg)
        cell.cond_txt   = self.utjan_xml:InitTextWnd("counter_text", cell.bg)
        cell.top_bg     = self.utjan_xml:InitStatic("background", cell.bg)
        cell.top_txt    = self.utjan_xml:InitTextWnd("counter_text", cell.bg)
        cell.repair_ico = self.utjan_xml:InitStatic("gun_repair_icon", cell.bg)
        cell.patch_ico  = self.utjan_xml:InitStatic("gun_repair_icon", cell.bg)
        cell.cond_bg:Show(false)
        cell.cond_txt:Show(false)
        cell.top_bg:Show(false)
        cell.top_txt:Show(false)
        cell.repair_ico:Show(false)
        cell.patch_ico:Show(false)
    end

    if not cell.stack_txt and self.utjan_xml then
        cell.stack_bg  = self.utjan_xml:InitStatic("background", cell.bg)
        cell.stack_txt = self.utjan_xml:InitTextWnd("counter_text", cell.bg)
        cell.stack_bg:Show(false)
        cell.stack_txt:Show(false)
    end

    -- Track occupied bottom-left width so Condition % and Part Dots never collide
    local bottom_left_x_offset = 2
    local cond_txt_h = 0

    -- ================================================================================
    -- A. ITEM CONDITION PERCENTAGE TEXT (Outfits, Helmets, Parts, Knives & Degradables)
    -- ================================================================================
    if hover_corpse_loot_mcm.get_config("show_cond_text") and cell.cond_txt then
        local is_multi = IsItem("multiuse", sec)
        local is_mag   = magazine_binder and magazine_binder.is_magazine(sec)
        local is_melee = IsMelee and IsMelee(obj, clsid) or false
        local is_part  = SYS_GetParam(1, sec, "cond_part", false)
                         or (string.find(sec, "^prt_w_") ~= nil)
                         or (string.find(sec, "^prt_o_") ~= nil)
        local is_deg   = utils_item.is_degradable(obj, sec)
                         or SYS_GetParam(1, sec, "use_condition", false)

        -- Show condition % on Armor/Helmets, Weapon/Outfit Parts, Melee weapons, and
        -- degradable items (like glowsticks), while keeping Firearms excluded so WPO
        -- part dots remain uncluttered.
        local show_pct = (is_arm or is_part or is_melee or (is_deg and not is_wpn))
                         and (not is_multi)
                         and (not is_mag)
                         and (not data.is_ammo)

        if show_pct then
            local cond = obj:condition()
            local c_clr = utils_xml.lerp_color(cond, DOT_COLORS.min_pt, DOT_COLORS.mid_pt, DOT_COLORS.max_pt)
            local pct_str = math.ceil(cond * 100) .. "%"
            local tw, th = set_utjan_badge_text(cell.cond_txt, cell.cond_bg, pct_str, c_clr)
            cond_txt_h = th

            -- In 1x1 mode if part dots are also shown on armor, place % in top-left so bottom is free for dots!
            local put_top = (not use_tetris) and hover_corpse_loot_mcm.get_config("show_part_dots") and is_arm
            local ty = put_top and 1 or (box_h - th)

            cell.cond_txt:SetWndPos(vector2():set(1, ty))
            cell.cond_bg:SetWndPos(vector2():set(1, ty))
            cell.cond_bg:Show(true)
            cell.cond_txt:Show(true)

            if not put_top then
                bottom_left_x_offset = tw + 2
            end
        end
    end

    -- ================================================================================
    -- B. UTJAN WEAPON & ARMOR PART CONDITION DOTS
    -- ================================================================================
    if hover_corpse_loot_mcm.get_config("show_part_dots") and (is_wpn or is_arm) and item_parts and itms_manager then
        local parent_sec = SYS_GetParam(0, sec, "parent_section") or sec
        local parts_str  = itms_manager.ini_parts and itms_manager.ini_parts:r_string_ex("con_parts_list", parent_sec)
        if parts_str then
            local se_parts = item_parts.get_parts_con(obj, nil, true)
            if se_parts and not is_empty(se_parts) then
                local valid_parts = {}
                for part, cond in pairs(se_parts) do
                    if SYS_GetParam(1, part, "cond_part") then
                        valid_parts[part] = cond
                    end
                end

                if not is_empty(valid_parts) then
                    local sort_fn = (z_item_icon_info and z_item_icon_info.parts_sort) or nil
                    local ordered = {}
                    for part, cond in spairs(valid_parts, sort_fn) do
                        ordered[#ordered + 1] = { part = part, cond = cond }
                    end

                    local num_dots = #ordered
                    if num_dots > 0 then
                        local u_set     = z_item_icon_info and z_item_icon_info.settings and z_item_icon_info.settings.part_dots
                        local wpo_mode  = (not u_set) or (u_set.wpo_mode ~= false)
                        local th_green  = (u_set and u_set.wpo_green) or 85
                        local th_yellow = (u_set and u_set.wpo_yellow) or 60
                        local th_orange = (u_set and u_set.wpo_orange) or 20
                        local size_mult = (u_set and u_set.size_mult) or 1.0

                        local dot_h, dot_w, gap
                        if use_tetris then
                            dot_h = UI_METRICS.dot_h_tactical * size_mult
                            dot_w = UI_METRICS.dot_w_tactical * size_mult
                            gap   = UI_METRICS.dot_gap_tactical
                        else
                            dot_h = UI_METRICS.dot_h_1x1
                            dot_w = UI_METRICS.dot_w_1x1
                            gap   = UI_METRICS.dot_gap_1x1
                        end

                        -- If in Tactical mode on a narrow item (like a 2x1 pistol or 2x3 helmet),
                        -- and Condition % is taking up the bottom-left, stack dots right above Condition %
                        local dot_start_x = bottom_left_x_offset
                        local dot_pos_y   = box_h - dot_h - UI_METRICS.dot_bottom_pad
                        local avail_w     = box_w - dot_start_x - 2

                        if ((num_dots * dot_w) + ((num_dots - 1) * gap)) > avail_w and bottom_left_x_offset > 2 then
                            dot_start_x = 2
                            dot_pos_y   = box_h - cond_txt_h - dot_h - 2
                            avail_w     = box_w - 4
                        end

                        local total_dots_w = (num_dots * dot_w) + ((num_dots - 1) * gap)
                        if total_dots_w > avail_w and num_dots > 0 then
                            gap   = 1.0
                            dot_w = math.max(2.0, (avail_w - ((num_dots - 1) * gap)) / num_dots)
                        end

                        cell.dots = cell.dots or {}
                        for i = 1, num_dots do
                            local entry = ordered[i]
                            local dot = cell.dots[i]
                            if not dot then
                                dot = self.utjan_xml:InitStatic("cond_dot", cell.bg)
                                cell.dots[i] = dot
                            end

                            local dx = dot_start_x + ((i - 1) * (dot_w + gap))
                            dot:SetWndRect(Frect():set(0, 0, dot_w, dot_h))
                            dot:SetWndPos(vector2():set(dx, dot_pos_y))

                            local cond = entry.cond
                            local color = DOT_COLORS.missing
                            if wpo_mode and is_wpn then
                                if cond >= th_green then color = DOT_COLORS.green
                                elseif cond >= th_yellow then color = DOT_COLORS.yellow
                                elseif cond >= th_orange then color = DOT_COLORS.orange
                                elseif cond > -1 then color = DOT_COLORS.red end
                            else
                                if cond >= 0 then
                                    local c_norm = clamp(cond / 99, 0, 1)
                                    color = utils_xml.lerp_color(c_norm, DOT_COLORS.min_pt, DOT_COLORS.mid_pt, DOT_COLORS.max_pt)
                                end
                            end

                            if color then dot:SetTextureColor(color) end
                            dot:Show(true)
                        end
                    end
                end
            end
        end
    end

    -- ================================================================================
    -- C. WEAPON & ARMOR REPAIR TYPE ICON (Top-Right Corner so it never overlaps dots!)
    -- ================================================================================
    local repair_icon_h = 0
    if hover_corpse_loot_mcm.get_config("show_repair_icon") and cell.repair_ico then
        if is_wpn then
            local rep_type = SYS_GetParam(0, sec, "repair_type")
            local tex = rep_type and GUN_REPAIR_TEXTURES[rep_type]
            if tex then
                cell.repair_ico:InitTexture(tex)
                cell.repair_ico:SetStretchTexture(true)
                local rw = (use_tetris and 13 or 10) * aspect
                local rh = (use_tetris and 13 or 10)
                cell.repair_ico:SetWndSize(vector2():set(rw, rh))
                -- Placed cleanly at Top-Right (box_w - rw - 2, 2)
                cell.repair_ico:SetWndPos(vector2():set(box_w - rw - 2, 2))
                cell.repair_ico:Show(true)
                repair_icon_h = rh + 2
            end
        elseif is_arm and dynamic_eq_icon and dynamic_eq_icon.get_repair_to_texture_table then
            local tx_tbl = dynamic_eq_icon.get_repair_to_texture_table(sec)
            if tx_tbl and tx_tbl[1] then
                local scale = use_tetris and 0.75 or 0.55
                local rw = (tonumber(tx_tbl[2]) or 16) * aspect * scale
                local rh = (tonumber(tx_tbl[3]) or 16) * scale
                cell.repair_ico:InitTexture(tx_tbl[1])
                cell.repair_ico:SetStretchTexture(true)
                cell.repair_ico:SetWndSize(vector2():set(rw, rh))
                -- Placed cleanly at Top-Right (box_w - rw - 2, 2)
                cell.repair_ico:SetWndPos(vector2():set(box_w - rw - 2, 2))
                cell.repair_ico:Show(true)
                repair_icon_h = rh + 2
            end
        end
    end

    -- ================================================================================
    -- D. OUTFIT FACTION PATCH MINI-ICON (Top-Right, directly below Repair Icon)
    -- ================================================================================
    if hover_corpse_loot_mcm.get_config("show_armor_patch") and is_arm and cell.patch_ico then
        if dynamic_eq_icon and dynamic_eq_icon.get_comm_to_texture then
            local tx_tbl = dynamic_eq_icon.get_comm_to_texture(sec)
            if tx_tbl and tx_tbl[1] then
                local scale = use_tetris and 0.75 or 0.55
                local pw = (tonumber(tx_tbl[2]) or 16) * aspect * scale
                local ph = (tonumber(tx_tbl[3]) or 16) * scale
                cell.patch_ico:InitTexture(tx_tbl[1])
                cell.patch_ico:SetStretchTexture(true)
                cell.patch_ico:SetWndSize(vector2():set(pw, ph))
                cell.patch_ico:SetWndPos(vector2():set(box_w - pw - 2, 2 + repair_icon_h))
                cell.patch_ico:Show(true)
            end
        end
    end

    -- ================================================================================
    -- E. PDA STASH (???) & RECIPE (new!/read) / AMMO NAME / MONEY VALUE
    -- ================================================================================
    if cell.top_txt then
        local shown_badge = false

        -- 1. PDA Stash & Recipe Status
        if hover_corpse_loot_mcm.get_config("show_pda_recipe") then
            local use_map = SYS_GetParam(0, sec, "use_map")
            local functor = SYS_GetParam(0, sec, "use1_action_functor", "na")
            local is_rec  = READABLE_FUNCTORS[functor] or (z_item_icon_info and z_item_icon_info.one_use_recipes and z_item_icon_info.one_use_recipes[sec])
            local is_pda  = (functor == "ui_pda_npc_tab.use_view")

            if is_pda then
                local pda_info = se_load_var(obj:id(), obj:name(), "info")
                if pda_info and pda_info.msg then
                    for k, v in pairs(pda_info.msg) do
                        if v.stash and not v.stash_read then
                            local tw, th = set_utjan_badge_text(cell.top_txt, cell.top_bg, "(???)", GetARGB(255, 255, 232, 208))
                            cell.top_txt:SetWndPos(vector2():set(1, box_h - th - 1))
                            cell.top_bg:SetWndPos(vector2():set(1, box_h - th - 1))
                            cell.top_bg:Show(true)
                            cell.top_txt:Show(true)
                            shown_badge = true
                            break
                        end
                    end
                end
            elseif is_rec or use_map then
                local known = false
                if use_map then
                    local maps = game_statistics and game_statistics.actor_anomaly_maps or {}
                    known = maps[use_map] or false
                else
                    local wai = workshop_autoinject and workshop_autoinject.known_recipe
                                or (z_item_icon_info and z_item_icon_info.workshop_autoinject_known_recipes) or {}
                    known = wai[sec] or (ui_pda_encyclopedia_tab and ui_pda_encyclopedia_tab.is_unlocked_note("encyclopedia__notes_" .. sec))
                end
                local r_txt = known and game.translate_string("ui_utjan_recipe_read") or game.translate_string("ui_utjan_recipe_unread")
                local r_clr = known and GetARGB(255, 185, 162, 138) or GetARGB(255, 255, 232, 208)
                local tw, th = set_utjan_badge_text(cell.top_txt, cell.top_bg, r_txt, r_clr)
                cell.top_txt:SetWndPos(vector2():set(1, box_h - th - 1))
                cell.top_bg:SetWndPos(vector2():set(1, box_h - th - 1))
                cell.top_bg:Show(true)
                cell.top_txt:Show(true)
                shown_badge = true
            end
        end

        -- 2. Ammo Short Name
        if not shown_badge and hover_corpse_loot_mcm.get_config("show_ammo_name") then
            local class = SYS_GetParam(0, sec, "class")
            if VALID_AMMO_CLASS[class] and not SYS_GetParam(1, sec, "is_component") then
                local short_id = SYS_GetParam(0, sec, "inv_name_short")
                if short_id then
                    local a_str = game.translate_string(short_id)
                    local a_clr = GetARGB(255, 225, 225, 225)
                    if string.find(sec, "_verybad") then a_clr = DOT_COLORS.red
                    elseif string.find(sec, "_bad") then a_clr = DOT_COLORS.orange end

                    local tw, th = set_utjan_badge_text(cell.top_txt, cell.top_bg, a_str, a_clr)
                    cell.top_txt:SetWndPos(vector2():set(1, 1))
                    cell.top_bg:SetWndPos(vector2():set(1, 1))
                    cell.top_bg:Show(true)
                    cell.top_txt:Show(true)
                    shown_badge = true
                end
            end
        end

        -- 3. Cash / Money Value
        if not shown_badge and hover_corpse_loot_mcm.get_config("show_money_text") then
            local money_amt = IsItem("money", sec) or parse_list(ini_sys, sec, "money_value")
            if money_amt and money_amt[1] then
                local m_str = money_amt[2] and (tostring((money_amt[1] + money_amt[2]) / 2) .. "~") or tostring(money_amt[1])
                local tw, th = set_utjan_badge_text(cell.top_txt, cell.top_bg, m_str, GetARGB(255, 230, 230, 230))
                cell.top_txt:SetWndPos(vector2():set(1, box_h - th - 1))
                cell.top_bg:SetWndPos(vector2():set(1, box_h - th - 1))
                cell.top_bg:Show(true)
                cell.top_txt:Show(true)
            end
        end
    end

    -- ================================================================================
    -- F. UTJAN-STYLE COMPACT ITEM & AMMO STACK COUNT
    --    (Bottom-Left for Ammo so it doesn't overlap Ammo Name; Top-Left for other items)
    -- ================================================================================
    if hover_corpse_loot_mcm.get_config("show_stack_count") and cell.stack_txt then
        if data.count > 1 or data.is_ammo then
            local s_str = "x" .. tostring(data.count)
            local tw, th = set_utjan_badge_text(cell.stack_txt, cell.stack_bg, s_str, GetARGB(255, 235, 235, 235))
            local sy = data.is_ammo and (box_h - th - 1) or 1
            cell.stack_txt:SetWndPos(vector2():set(1, sy))
            if cell.stack_bg then
                cell.stack_bg:SetWndPos(vector2():set(1, sy))
                cell.stack_bg:Show(true)
            end
            cell.stack_txt:Show(true)
        end
    end

    -- ================================================================================
    -- G. SORTINGPLUS FAVORITE (STAR) & JUNK (TRASH) ICONS
    -- ================================================================================
    if zzz_rax_sortingplus_mcm then
        local show_fav_ico  = (zzz_rax_sortingplus_mcm.ICONFAVS ~= false) and data.is_fav
        local show_junk_ico = (zzz_rax_sortingplus_mcm.ICONJUNK ~= false) and data.is_junk

        if show_fav_ico then
            if not cell.fav_ico then
                cell.fav_ico = self.xml:InitStatic("hover_loot_frame:cell_icon", cell.bg)
                cell.fav_ico:InitTexture("ui\\sortingplus\\icon-favourite")
                cell.fav_ico:SetStretchTexture(true)
            end
            local iw = math.min(14, box_w * 0.4) * aspect
            local ih = math.min(14, box_h * 0.4)
            cell.fav_ico:SetWndSize(vector2():set(iw, ih))
            cell.fav_ico:SetWndPos(vector2():set(1, math.max(1, (box_h / 2) - (ih / 2) - 2)))
            cell.fav_ico:Show(true)
        elseif show_junk_ico then
            if not cell.junk_ico then
                cell.junk_ico = self.xml:InitStatic("hover_loot_frame:cell_icon", cell.bg)
                cell.junk_ico:InitTexture("ui\\sortingplus\\icon-junk")
                cell.junk_ico:SetStretchTexture(true)
            end
            local iw = math.min(14, box_w * 0.4) * aspect
            local ih = math.min(14, box_h * 0.4)
            cell.junk_ico:SetWndSize(vector2():set(iw, ih))
            cell.junk_ico:SetWndPos(vector2():set(math.max(1, box_w - iw - 1), math.max(1, (box_h / 2) - (ih / 2))))
            cell.junk_ico:Show(true)
        end
    end
end

---------------------------------------------------------------------------------------
-- Finds the first free (row, col) coordinate in a 2D occupancy grid that can fit
-- an item of size (w, h), and marks those cells as occupied.
-- Arguments: grid (table), max_cols (number), w (number), h (number)
-- Returns: placed_col (number), placed_row (number) - 0-indexed grid coordinates
---------------------------------------------------------------------------------------
local function find_and_mark_tetris_slot(grid, max_cols, w, h)
    local row = 1
    while row < 100 do
        for col = 1, math.max(1, max_cols - w + 1) do
            local fits = true
            for r = row, row + h - 1 do
                grid[r] = grid[r] or {}
                for c = col, col + w - 1 do
                    if grid[r][c] then
                        fits = false
                        break
                    end
                end
                if not fits then break end
            end

            if fits then
                for r = row, row + h - 1 do
                    grid[r] = grid[r] or {}
                    for c = col, col + w - 1 do
                        grid[r][c] = true
                    end
                end
                return (col - 1), (row - 1)
            end
        end
        row = row + 1
    end
    return 0, 0
end

---------------------------------------------------------------------------------------
-- Renders the item grid for ALL three styles (1 = Minimal, 2 = Tactical Tetris,
-- 3 = Compact 1x1 Uniform Squares). Supports automatic vertical viewport scrolling
-- when `max_row_used` exceeds the MCM `max_rows` height cap.
-- Arguments: grouped_items (table), ui_style (number), cell_size (number), cols (number)
-- Returns: body_w (number), body_h (number) - Visible pixel dimensions of the rendered grid
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:BuildItemGrid(grouped_items, ui_style, cell_size, cols)
    for i = 1, #self.cell_pool do
        self.cell_pool[i].bg:Show(false)
    end

    local aspect   = utils_xml.is_widescreen() and 0.8 or 1.0
    local cell_w   = math.floor(cell_size * aspect)
    local cell_h   = cell_size
    local gap      = UI_METRICS.cell_gap
    local bg_alph  = hover_corpse_loot_mcm.get_config("bg_alpha")
    local max_rows = hover_corpse_loot_mcm.get_config("max_rows") or 8

    local use_tetris = (ui_style == 2)
    local max_col_used, max_row_used = 0, 0

    if hover_corpse_loot_actions and hover_corpse_loot_actions.sort_and_assign_rows then
        max_col_used, max_row_used = hover_corpse_loot_actions.sort_and_assign_rows(self, grouped_items, use_tetris, cols)
    else
        local occupancy_grid = {}
        for idx = 1, #grouped_items do
            local data = grouped_items[idx]
            local span_w = use_tetris and math.min(cols, data.inv_w) or 1
            local span_h = use_tetris and data.inv_h or 1
            local grid_c, grid_r = find_and_mark_tetris_slot(occupancy_grid, cols, span_w, span_h)
            data.grid_c, data.grid_r, data.span_w, data.span_h = grid_c, grid_r, span_w, span_h
            max_col_used = math.max(max_col_used, grid_c + span_w)
            max_row_used = math.max(max_row_used, grid_r + span_h)
        end
    end

    self.current_grouped = grouped_items
    if self.selected_idx and self.selected_idx > #grouped_items then
        self.selected_idx = (#grouped_items > 0) and #grouped_items or nil
    end
    if self.target_id and self.selected_idx then
        self.last_active_corpse_id = self.target_id
        self.last_active_sel_idx   = self.selected_idx
    end

    -- ================================================================================
    -- VERTICAL VIEWPORT WINDOW CALCULATION (Caps grid height to `max_rows`)
    -- ================================================================================
    local vis_rows = math.min(max_row_used, max_rows)
    if max_row_used <= max_rows then
        self.view_start_r = 0
    else
        local sel_data = self.selected_idx and grouped_items[self.selected_idx]
        if sel_data then
            local item_top = sel_data.grid_r
            local item_bot = sel_data.grid_r + sel_data.span_h
            if item_top < self.view_start_r then
                self.view_start_r = item_top
            elseif item_bot > (self.view_start_r + vis_rows) then
                self.view_start_r = item_bot - vis_rows
            end
        end
        self.view_start_r = clamp(self.view_start_r, 0, math.max(0, max_row_used - vis_rows))
    end
    local view_end_r = self.view_start_r + vis_rows

    -- Step 3: Render cells that fall inside the active vertical viewport [view_start_r, view_end_r]
    for idx = 1, #grouped_items do
        local data = grouped_items[idx]
        local cell = self.cell_pool[idx]

        if not cell then
            cell = {}
            cell.bg = self.xml:InitStatic("hover_loot_frame:cell_bg", self.grid_container)
            if self.utjan_xml then
                cell.bg_boost = self.utjan_xml:InitStatic("cond_dot", cell.bg)
                local tr = cell.bg_boost:GetTextureRect()
                local cx = (tr.x1 + tr.x2) * 0.5
                local cy = (tr.y1 + tr.y2) * 0.5
                cell.bg_boost:SetTextureRect(Frect():set(cx - 0.5, cy - 0.5, cx + 0.5, cy + 0.5))
                cell.bg_boost:SetStretchTexture(true)
            else
                cell.bg_boost = self.xml:InitStatic("hover_loot_frame:cell_bg", cell.bg)
            end
            cell.icon_temp = self.xml:InitStatic("hover_loot_frame:cell_icon_temp", cell.bg)
            cell.icon      = self.xml:InitStatic("hover_loot_frame:cell_icon", cell.bg)
            cell.dots      = {}
            self.cell_pool[idx] = cell
        end

        local item_top = data.grid_r
        local item_bot = data.grid_r + data.span_h

        -- Only show items that fit within the current vertical viewport window
        if item_top >= self.view_start_r and item_bot <= view_end_r then
            local rel_r = item_top - self.view_start_r
            local box_x = data.grid_c * (cell_w + gap)
            local box_y = rel_r * (cell_h + gap)
            local box_w = (data.span_w * cell_w) + ((data.span_w - 1) * gap)
            local box_h = (data.span_h * cell_h) + ((data.span_h - 1) * gap)

            cell.bg:SetWndPos(vector2():set(box_x, box_y))
            cell.bg:SetWndSize(vector2():set(box_w, box_h))

            if self.selected_idx == idx and hover_corpse_loot_quickloot then
                local sel_clr = hover_corpse_loot_quickloot.get_selection_color()
                cell.bg:SetTextureColor(sel_clr)
                cell.bg_boost:SetWndPos(vector2():set(0, 0))
                cell.bg_boost:SetWndSize(vector2():set(box_w, box_h))
                cell.bg_boost:SetTextureColor(sel_clr)
                cell.bg_boost:Show(true)
            elseif zzz_rax_sortingplus_mcm and data.is_fav and (zzz_rax_sortingplus_mcm.HILITEFAVS ~= false) then
                local fav_clr = GetARGB(80, 176, 238, 26)
                cell.bg:SetTextureColor(fav_clr)
                cell.bg_boost:SetWndPos(vector2():set(0, 0))
                cell.bg_boost:SetWndSize(vector2():set(box_w, box_h))
                cell.bg_boost:SetTextureColor(fav_clr)
                cell.bg_boost:Show(true)
            elseif zzz_rax_sortingplus_mcm and data.is_junk and (zzz_rax_sortingplus_mcm.HILITEJUNK ~= false) then
                local junk_clr = GetARGB(80, 204, 0, 0)
                cell.bg:SetTextureColor(junk_clr)
                cell.bg_boost:SetWndPos(vector2():set(0, 0))
                cell.bg_boost:SetWndSize(vector2():set(box_w, box_h))
                cell.bg_boost:SetTextureColor(junk_clr)
                cell.bg_boost:Show(true)
            else
                cell.bg:SetTextureColor(GetARGB(math.min(255, bg_alph + 15), UI_METRICS.cell_tint_r, UI_METRICS.cell_tint_g, UI_METRICS.cell_tint_b))
                cell.bg_boost:Show(false)
            end
            cell.bg:Show(true)

            local pad = 3
            cell.icon_temp:SetWndPos(vector2():set(pad, pad))
            cell.icon_temp:SetWndSize(vector2():set(math.max(8, box_w - pad * 2), math.max(8, box_h - pad * 2)))
            cell.icon:SetWndPos(vector2():set(pad, pad))
            cell.icon:SetWndSize(vector2():set(math.max(8, box_w - pad * 2), math.max(8, box_h - pad * 2)))

            utils_xml.set_icon(data.sec, false, cell.icon_temp, cell.icon)
            cell.icon:Show(true)

            -- Render weapon attachments (Scopes, Suppressors, GLs) and auto-fit inside cell bounds
            self:RenderItemIconLayers(cell, data, box_w, box_h, aspect)

            self:RenderUtjanOverlays(cell, data, box_w, box_h, use_tetris, aspect)
        else
            cell.bg:Show(false)
        end
    end

    self.total_rows_used = max_row_used
    self.vis_rows_used   = vis_rows

    local total_grid_w = (max_col_used * cell_w) + (math.max(0, max_col_used - 1) * gap)
    local total_grid_h = (vis_rows * cell_h) + (math.max(0, vis_rows - 1) * gap)
    return total_grid_w, total_grid_h
end

---------------------------------------------------------------------------------------
-- Populates and dynamically positions all UI elements for a target corpse.
-- Arguments: npc (game_object) - The dead stalker being hovered over
--            force_refresh (boolean) - Forces a rebuild even if state hasn't changed
-- Returns: None
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:UpdateCorpseData(npc, force_refresh)
    if not npc then return end
    local id = npc:id()

    hover_corpse_loot_tracker.ensure_corpse_loot_generated(npc)

    local raw_count, raw_items = self:GetRawCorpseItems(npc)
    local is_looted = hover_corpse_loot_tracker.is_corpse_looted(id)

    if self.target_id == id
       and not force_refresh
       and self:IsShown()
       and self.last_item_count == raw_count
       and self.last_looted_st == is_looted then
        return
    end

    if self.target_id ~= id or force_refresh then
        self.is_claimed = hover_corpse_loot_tracker.is_corpse_claimed(npc)
    end

    -- Persistent Cursor Memory:
    -- If returning to the EXACT SAME corpse after looking away to check for threats,
    -- restore `last_active_sel_idx`. If hovering over a DIFFERENT corpse, reset to nil!
    if self.target_id ~= id then
        self.view_start_r = 0
        if not self.is_claimed and self.last_active_corpse_id == id and self.last_active_sel_idx ~= nil then
            self.selected_idx = self.last_active_sel_idx
        else
            self.selected_idx          = nil
            self.last_active_corpse_id = nil
            self.last_active_sel_idx   = nil
        end
    end

    if self.is_claimed then
        self.selected_idx          = nil
        self.last_active_corpse_id = nil
        self.last_active_sel_idx   = nil
    end

    self.target_id       = id
    self.last_item_count = raw_count
    self.last_looted_st  = is_looted

    local ui_style     = hover_corpse_loot_mcm.get_config("ui_style")
    local cell_size    = hover_corpse_loot_mcm.get_config("cell_size")
    local cols         = hover_corpse_loot_mcm.get_config("grid_cols")
    local show_subinfo = hover_corpse_loot_mcm.get_config("show_subinfo") and (ui_style ~= 1)
    local bg_alpha     = hover_corpse_loot_mcm.get_config("bg_alpha")

    if ui_style == 1 then
        cols = math.max(cols, 8)
    end

    local header_h = show_subinfo and UI_METRICS.header_height_full or UI_METRICS.header_height_slim
    local cursor_x = UI_METRICS.padding_x
    local aspect   = utils_xml.is_widescreen() and 0.8 or 1.0

    local has_faction, community, rank_name, role_id = self:SetupHeaderIcons(npc, cursor_x, header_h, aspect)
    if has_faction then
        cursor_x = cursor_x + (UI_METRICS.faction_w * aspect) + UI_METRICS.icon_gap
    end

    local char_name = npc:character_name() or "Unknown"
    self.npc_name:SetText(char_name)

    local sub_str = ""
    if show_subinfo then
        local rank_str = game.translate_string("st_rank_" .. rank_name)

        local comm_str
        if community == "trader" then
            comm_str = game.translate_string("st_hcl_role_trader")
        else
            comm_str = game.translate_string("st_faction_" .. community)
            if role_id then
                local role_str = game.translate_string("st_hcl_role_" .. role_id)
                comm_str = comm_str .. UI_METRICS.clr_bullet_sep .. role_str
            end
        end

        sub_str = rank_str .. UI_METRICS.clr_bullet_sep .. comm_str
        self.npc_subinfo:SetText(sub_str)
        self.npc_subinfo:Show(true)
    else
        self.npc_subinfo:Show(false)
    end

    local status_str = self:UpdateLootedStatusWidget(is_looted)

    local name_y = show_subinfo and UI_METRICS.name_y_full or UI_METRICS.name_y_slim
    self.npc_name:SetWndPos(vector2():set(cursor_x, name_y))
    self.npc_subinfo:SetWndPos(vector2():set(cursor_x, UI_METRICS.subinfo_y))

    -- If corpse is claimed by an NPC, hide all items and clear current_grouped!
    local grouped_items = self.is_claimed and {} or self:GroupCorpseItems(raw_items)
    self.current_grouped = grouped_items
    local body_w = 0
    local body_h = 0
    local grid_top_y = header_h + UI_METRICS.padding_y

    if #grouped_items == 0 then
        self.grid_container:Show(false)
        self.selected_idx = nil
        if self.last_active_corpse_id == id then
            self.last_active_sel_idx = nil
        end
        body_w = UI_METRICS.min_window_width
        body_h = UI_METRICS.empty_label_h
    else
        self.empty_label:Show(false)
        self.grid_container:Show(true)

        body_w, body_h = self:BuildItemGrid(grouped_items, ui_style, cell_size, cols)
        self.grid_container:SetWndSize(vector2():set(body_w, body_h))
    end

    local show_footer = hover_corpse_loot_mcm.get_config("show_footer")
    local footer_h    = show_footer and UI_METRICS.footer_height or 0

    local line1_w = math.ceil(#char_name * UI_METRICS.char_px_width * aspect) + 10
    local line2_w = math.ceil((#sub_str + #status_str + 3) * (UI_METRICS.char_px_width * 0.9) * aspect) + 14
    local header_req_w = cursor_x + math.max(line1_w, line2_w) + UI_METRICS.padding_x

    local total_w = math.max(UI_METRICS.min_window_width, body_w + (UI_METRICS.padding_x * 2), header_req_w)
    local total_h = header_h + body_h + (UI_METRICS.padding_y * 2) + footer_h

    if #grouped_items == 0 then
        self.scroll_track:Show(false)
        self.scroll_thumb:Show(false)
        if self.is_claimed then
            self.empty_label:SetText(game.translate_string("st_hcl_claimed"))
            self.empty_label:SetTextColor(GetARGB(255, 255, 215, 50)) -- Bright Yellow for <Claimed>
        else
            self.empty_label:SetText(game.translate_string("st_hcl_empty"))
            self.empty_label:SetTextColor(GetARGB(255, 150, 150, 150)) -- Grey for <Empty>
        end
        self.empty_label:SetWndPos(vector2():set(0, grid_top_y - 2))
        self.empty_label:SetWndSize(vector2():set(total_w, UI_METRICS.empty_label_h))
        self.empty_label:Show(true)
    else
        local grid_x = math.max(UI_METRICS.padding_x, (total_w - body_w) / 2)
        self.grid_container:SetWndPos(vector2():set(grid_x, grid_top_y))

        if self.total_rows_used and self.vis_rows_used and self.total_rows_used > self.vis_rows_used then
            local sb_x = total_w - 5
            local sb_w = 3
            local thumb_ratio = self.vis_rows_used / self.total_rows_used
            local thumb_h     = math.max(12, math.floor(body_h * thumb_ratio))
            local max_scroll  = math.max(1, self.total_rows_used - self.vis_rows_used)
            local scroll_pct  = clamp(self.view_start_r / max_scroll, 0, 1)
            local thumb_y     = grid_top_y + math.floor((body_h - thumb_h) * scroll_pct)

            self.scroll_track:SetWndPos(vector2():set(sb_x, grid_top_y))
            self.scroll_track:SetWndSize(vector2():set(sb_w, body_h))
            self.scroll_track:SetTextureColor(GetARGB(140, 35, 35, 40))
            self.scroll_track:Show(true)

            self.scroll_thumb:SetWndPos(vector2():set(sb_x, thumb_y))
            self.scroll_thumb:SetWndSize(vector2():set(sb_w, thumb_h))
            self.scroll_thumb:SetTextureColor(GetARGB(220, 185, 185, 195))
            self.scroll_thumb:Show(true)
        else
            self.scroll_track:Show(false)
            self.scroll_thumb:Show(false)
        end
    end

    self.npc_name:SetWndSize(vector2():set(total_w - cursor_x - UI_METRICS.padding_x, 18))
    self.npc_subinfo:SetWndSize(vector2():set(total_w - cursor_x - UI_METRICS.padding_x, 14))

    local looted_y = show_subinfo and UI_METRICS.looted_y_full or UI_METRICS.looted_y_slim
    local looted_w = 110
    self.looted_status:SetWndPos(vector2():set(total_w - looted_w - UI_METRICS.padding_x, looted_y))
    self.looted_status:SetWndSize(vector2():set(looted_w, 14))

    self.frame:SetWndSize(vector2():set(total_w, total_h))

    self.border_frame:Show(false)

    self.bg_frame:SetWndPos(vector2():set(0, 0))
    self.bg_frame:SetWndSize(vector2():set(total_w, total_h))
    self.bg_frame:SetTextureColor(GetARGB(bg_alpha, UI_METRICS.bg_tint_r, UI_METRICS.bg_tint_g, UI_METRICS.bg_tint_b))

    self.header_bg:SetWndPos(vector2():set(0, 0))
    self.header_bg:SetWndSize(vector2():set(total_w, header_h))
    self.header_bg:SetTextureColor(GetARGB(math.min(255, bg_alpha + 40), UI_METRICS.hdr_tint_r, UI_METRICS.hdr_tint_g, UI_METRICS.hdr_tint_b))

    self.header_line:SetWndPos(vector2():set(4, header_h))
    self.header_line:SetWndSize(vector2():set(total_w - 8, 1))
    self.header_line:SetTextureColor(GetARGB(130, 120, 120, 125))

    -- Persistent Bottom Footer Bar (Shows selected item's localized name!)
    if show_footer then
        local footer_y = total_h - footer_h
        self.footer_bg:SetWndPos(vector2():set(0, footer_y))
        self.footer_bg:SetWndSize(vector2():set(total_w, footer_h))
        self.footer_bg:SetTextureColor(GetARGB(math.min(255, bg_alpha + 40), UI_METRICS.hdr_tint_r, UI_METRICS.hdr_tint_g, UI_METRICS.hdr_tint_b))
        self.footer_bg:Show(true)

        self.footer_line:SetWndPos(vector2():set(4, footer_y))
        self.footer_line:SetWndSize(vector2():set(total_w - 8, 1))
        self.footer_line:SetTextureColor(GetARGB(130, 120, 120, 125))
        self.footer_line:Show(true)

        local sel_entry = self.selected_idx and grouped_items[self.selected_idx]
        if sel_entry and sel_entry.sec then
            local inv_name = ui_item.get_sec_name(sel_entry.sec)
            self.footer_text:SetText(inv_name or "")
            self.footer_text:SetTextColor(GetARGB(255, 235, 235, 235))
        else
            self.footer_text:SetText("")
        end
        self.footer_text:SetWndPos(vector2():set(UI_METRICS.padding_x, footer_y + 4))
        self.footer_text:SetWndSize(vector2():set(total_w - (UI_METRICS.padding_x * 2), footer_h - 6))
        self.footer_text:Show(true)
    else
        self.footer_bg:Show(false)
        self.footer_line:Show(false)
        self.footer_text:Show(false)
    end

    local screen_x = 512 + hover_corpse_loot_mcm.get_config("offset_x")
    local screen_y = 384 + hover_corpse_loot_mcm.get_config("offset_y")
    screen_x = math.min(screen_x, 1020 - total_w)
    screen_y = math.min(screen_y, 760 - total_h)

    self.frame:SetWndPos(vector2():set(screen_x, screen_y))
    self:ShowWnd()
end

---------------------------------------------------------------------------------------
-- Attaches the window to the main game HUD and shows the frame.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:ShowWnd()
    if not self.frame:IsShown() then
        self.frame:Show(true)
        get_hud():AddDialogToRender(self)
    end
end

---------------------------------------------------------------------------------------
-- Hides the window and removes it from the HUD render queue cleanly.
-- Remembers the last active corpse ID and selected item index in case the player
-- only turned away momentarily to scan for threats.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:Hide()
    if self.target_id and self.selected_idx then
        self.last_active_corpse_id = self.target_id
        self.last_active_sel_idx   = self.selected_idx
    end
    self.target_id       = nil
    self.last_item_count = -1
    self.last_looted_st  = nil
    self.selected_idx    = nil
    self.current_grouped = {}
    self.grid_rows       = {}
    if hover_corpse_loot_quickloot and hover_corpse_loot_quickloot.on_ui_hidden then
        hover_corpse_loot_quickloot.on_ui_hidden()
    end
    if self.frame and self.frame:IsShown() then
        self.frame:Show(false)
        get_hud():RemoveDialogToRender(self)
    end
end


---------------------------------------------------------------------------------------
-- Returns whether the Hover Loot UI frame is currently visible on the HUD.
-- Arguments: None
-- Returns: (boolean) - True if visible, false otherwise
---------------------------------------------------------------------------------------
function UIHoverCorpseLoot:IsShown()
    return self.frame and self.frame:IsShown()
end