--[[
=======================================================================================
    Hover Corpse Loot UI - Module 3: Dynamic HUD Window & Layout Renderer
    File: hover_corpse_loot_ui.script
    Description: Manages the HUD popup window when hovering over dead stalkers.
                 Features full, MCM-customizable integration with Utjan's Item UI
                 Improvements (part dots, condition %, repair type icons, armor patches,
                 PDA stash tags, recipe read status, ammo names, and stack counts).
=======================================================================================
--]]


---------------------------------------------------------------------------------------
-- Lightweight, toggleable chokepoint logger for Hover Corpse Loot UI.
-- Arguments: lvl (number) - Debug level (1=ERROR, 2=WARN/STATE, 3=VERBOSE)
--            fn_name (string) - Name of the calling function
--            msg (string) - Formatted message with variable states
-- Returns: None
---------------------------------------------------------------------------------------

-- Debug Levels: 0 = OFF, 1 = ERROR, 2 = WARN/STATE, 3 = VERBOSE
local DEBUG_LEVEL = 0

local function hcl_log(lvl, fn_name, msg)
    if DEBUG_LEVEL >= lvl and printf then
        local lvl_tag = (lvl == 1 and "ERROR") or (lvl == 2 and "STATE") or "VERBOSE"
        printf("[HoverCorpseLoot] | <%s> | [%s] %s", tostring(fn_name), lvl_tag, tostring(msg))
    end
end


