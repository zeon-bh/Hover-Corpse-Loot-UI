--[[
=======================================================================================
    Hover Corpse Loot UI - Module 5: Interactive Mouse-Wheel Quick-Loot & FDDA Handler
    File: hover_corpse_loot_quickloot.script
    Description: Handles mouse-wheel item selection, flat cell highlight colors with
                 MCM brightness control, unified press-hold-release mouse & modifier
                 controls (LMB Sweep-Loot, RMB Sweep-Disassemble, Alt+Click Strip/Disassemble),
                 item/stack transfer, and Redone FDDA body-search animations.
=======================================================================================
--]]

-- Debug Levels: 0 = OFF, 1 = ERROR, 2 = WARN/STATE, 3 = VERBOSE
local DEBUG_LEVEL = 0

---------------------------------------------------------------------------------------
-- Lightweight, toggleable chokepoint logger for Module 5 (Quick-Loot & Input Handler).
-- Arguments: lvl (number) - Debug level (1=ERROR, 2=WARN/STATE, 3=VERBOSE)
--            fn_name (string) - Name of the calling function
--            msg (string) - Formatted message with variable states
-- Returns: None
---------------------------------------------------------------------------------------
local function hcl_log(lvl, fn_name, msg)
    if DEBUG_LEVEL >= lvl and printf then
        local lvl_tag = (lvl == 1 and "ERROR") or (lvl == 2 and "STATE") or "VERBOSE"
        printf("[HoverCorpseLoot:QuickLoot] | <%s> | [%s] %s", tostring(fn_name), lvl_tag, tostring(msg))
    end
end

-- Base RGB Palettes for Flat Cell Selection Highlight (Pure, saturated colors)
local SELECTION_PALETTES = {
    [1] = { r = 255, g = 185, b = 25  }, -- 1: Tactical Amber / Gold
    [2] = { r = 35,  g = 255, b = 65  }, -- 2: Bright Stalker Green
    [3] = { r = 240, g = 245, b = 255 }, -- 3: Crisp White / Silver
    [4] = { r = 25,  g = 215, b = 255 }, -- 4: Clear Sky Cyan
    [5] = { r = 255, g = 45,  b = 45  }, -- 5: Crimson Red
}

-- State tracking for mouse wheel debounce, FDDA animation, and press-hold-release guards
local last_wheel_time     = 0
local fdda_active_corpse  = nil
local block_input_grace_t = 0

-- Mouse Button Hold & Sweep-Loot / Sweep-Disassemble Guards:
-- Ensures single-click LMB (Loot Selected) and RMB (Loot All) only trigger on `on_key_release`,
-- and suppresses release-looting if the player scrolled while holding the mouse button to sweep!
local lmb_held  = false
local lmb_swept = false
local rmb_held  = false
local rmb_swept = false

---------------------------------------------------------------------------------------
-- Resets all active mouse button hold and sweep guard flags cleanly.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
local function reset_mouse_hold_states()
    lmb_held  = false
    lmb_swept = false
    rmb_held  = false
    rmb_swept = false
end

---------------------------------------------------------------------------------------
-- Computes the ARGB color for the selected cell's flat background, scaling saturation
-- and alpha proportionally with the MCM `sel_brightness` slider (0.5 to 2.5) without
-- washing the colors out to white!
-- Arguments: None
-- Returns: (number) - ARGB color integer
---------------------------------------------------------------------------------------
function get_selection_color()
    local clr_idx = hover_corpse_loot_mcm.get_config("sel_color") or 1
    local mult    = hover_corpse_loot_mcm.get_config("sel_brightness") or 1.5
    local pal     = SELECTION_PALETTES[clr_idx] or SELECTION_PALETTES[1]

    -- Scale RGB channels proportionally so colors remain distinct (Amber, Green, Cyan, Red)
    local scale = clamp(mult, 0.4, 2.0)
    local r = clamp(math.floor(pal.r * scale), 0, 255)
    local g = clamp(math.floor(pal.g * scale), 0, 255)
    local b = clamp(math.floor(pal.b * scale), 0, 255)
    -- Scale alpha from 140 (at 0.5x) up to 255 (at 1.5x+) for rich, solid brightness
    local a = clamp(math.floor(95 * mult), 40, 230)

    return GetARGB(a, r, g, b)
end

---------------------------------------------------------------------------------------
-- Starts Liz's Redone FDDA body search animation (without opening the full Inventory GUI)
-- when the player first scrolls the mouse wheel to select an item on a corpse.
-- Arguments: npc (game_object) - The corpse being searched
-- Returns: None
---------------------------------------------------------------------------------------
local function start_hover_fdda_animation(npc)
    if not hover_corpse_loot_mcm.get_config("fdda_anim") then return end
    if not (liz_fdda_redone_body_search and lam2) then return end
    if not npc then return end

    local id = npc:id()
    if fdda_active_corpse == id and lam2.get_action_with_tag("body_search") then
        return
    end

    fdda_active_corpse = id

    if liz_fdda_redone_body_search.haruka_scavanger_effect then
        liz_fdda_redone_body_search.haruka_scavanger_effect()
    end

    if lam2.get_action_with_tag("body_search") then return end

    local start_act = liz_fdda_redone_body_search.get_template_action_looting_start(npc, false)
    local orig_enter = start_act.on_enter
    start_act.on_enter = function(self)
        if orig_enter then orig_enter(self) end
        level.enable_input()
    end
    lam2.add_action(start_act)

    local idle_act = lam2.get_template_action_play_animation()
    idle_act.tag                 = "body_search"
    idle_act.sec                 = "liz_body_search_animation"
    idle_act.anm                 = "anm_idle"
    idle_act.hands               = liz_fdda_redone_body_search.pick_hand()
    idle_act.anm_blend           = true
    idle_act.only_allow_movekeys = true
    idle_act.can_skip            = true
    idle_act.on_execute = function(self, time)
        local ui = hover_corpse_loot_ui and hover_corpse_loot_ui.get_ui()
        if not ui or not ui:IsShown() or not ui.selected_idx or fdda_active_corpse ~= id then
            lam2.add_action_first(liz_fdda_redone_body_search.get_template_action_looting_end())
            fdda_active_corpse = nil
            return lam2.states.success
        end
        return lam2.states.running
    end
    lam2.add_action(idle_act)
end

---------------------------------------------------------------------------------------
-- Called automatically by UIHoverCorpseLoot:Hide() when the hover window closes.
-- Signals any active FDDA hover-search animation to play its end transition and
-- clears any pending mouse button hold/sweep states.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_ui_hidden()
    fdda_active_corpse = nil
    reset_mouse_hold_states()
end

---------------------------------------------------------------------------------------
-- Fires Grok's stash check (including Black Road Revisited) and marks the corpse as
-- `(Looted)` directly WITHOUT broadcasting `SendScriptCallback("npc_on_use")`, which
-- prevents other GAMMA mods from opening the full-screen Inventory GUI!
-- Arguments: npc (game_object) - The corpse being looted
-- Returns: None
---------------------------------------------------------------------------------------
function trigger_corpse_searched_callbacks(npc)
    if not npc then return end
    local id = npc:id()

    if not hover_corpse_loot_tracker.is_corpse_looted(id) then
        if grok_stashes_on_corpses and grok_stashes_on_corpses.npc_on_use then
            grok_stashes_on_corpses.npc_on_use(npc, db.actor)
        else
            hover_corpse_loot_tracker.mark_corpse_looted(id)
        end
    end

    if liz_fdda_redone_body_search and liz_fdda_redone_body_search.haruka_scavanger_effect then
        liz_fdda_redone_body_search.haruka_scavanger_effect()
    end
end

---------------------------------------------------------------------------------------
-- Transfers the currently highlighted item (or stack) from the corpse to the player.
-- Arguments: None
-- Returns: (boolean) - True if an item was transferred
---------------------------------------------------------------------------------------
function action_take_selected()
    local ui = hover_corpse_loot_ui and hover_corpse_loot_ui.get_ui()
    if not ui or not ui:IsShown() or not ui.selected_idx or not ui.target_id then
        return false
    end

    local npc = level.object_by_id(ui.target_id)
    if not npc then return false end

    local grouped = ui.current_grouped
    if not grouped or #grouped == 0 then return false end

    local entry = grouped[ui.selected_idx]
    if not entry then return false end

    trigger_corpse_searched_callbacks(npc)

    local stack_mode = hover_corpse_loot_mcm.get_config("stack_mode") or 1
    local tg = time_global()
    ui.pending_transferred_ids = ui.pending_transferred_ids or {}
    if stack_mode == 1 and entry.raw_list and #entry.raw_list > 1 then
        for i = 1, #entry.raw_list do
            local itm = entry.raw_list[i]
            if itm then
                npc:transfer_item(itm, db.actor)
                ui.pending_transferred_ids[itm:id()] = tg + 250
            end
        end
    else
        if entry.item then
            npc:transfer_item(entry.item, db.actor)
            ui.pending_transferred_ids[entry.item:id()] = tg + 250
        end
    end

    ui:UpdateCorpseData(npc, true)
    return true
end

---------------------------------------------------------------------------------------
-- Transfers ALL lootable items from the corpse to the player at once.
-- Arguments: None
-- Returns: (boolean) - True if items were transferred
---------------------------------------------------------------------------------------
function action_take_all()
    local ui = hover_corpse_loot_ui and hover_corpse_loot_ui.get_ui()
    if not ui or not ui:IsShown() or not ui.selected_idx or not ui.target_id then
        return false
    end

    local npc = level.object_by_id(ui.target_id)
    if not npc then return false end

    local raw_count, raw_items = ui:GetRawCorpseItems(npc)
    if not raw_items or #raw_items == 0 then return false end

    trigger_corpse_searched_callbacks(npc)

    for i = 1, #raw_items do
        local itm = raw_items[i]
        if itm then
            npc:transfer_item(itm, db.actor)
        end
    end

    ui.selected_idx = nil
    fdda_active_corpse = nil
    reset_mouse_hold_states()
    ui:UpdateCorpseData(npc, true)
    return true
end

---------------------------------------------------------------------------------------
-- Callback fired when the player scrolls the mouse wheel (`on_mouse_wheel`).
-- Supports:
--   1. Hold Left Click + Scroll: Bidirectional Row-Sweep Loot (`lmb_swept = true`)
--   2. Hold Right Click + Scroll: Bidirectional Row-Sweep Disassemble (`rmb_swept = true`)
--   3. Normal Scroll / Modifier (`Alt`) + Scroll: 2D Grid Navigation (or Wake-Up on rehover)
-- Arguments: dir (number) - Scroll direction (1 = Up/Forward, 0 or -1 = Down/Backward)
--            flags (table) - Modded Exes callback flags table
-- Returns: None
---------------------------------------------------------------------------------------
function on_mouse_wheel(dir, flags)
    if not hover_corpse_loot_mcm.get_config("enabled") then return end
    if not hover_corpse_loot_mcm.get_config("ql_enabled") then return end

    local ui = hover_corpse_loot_ui and hover_corpse_loot_ui.get_ui()
    if not ui or not ui:IsShown() or not ui.target_id then return end

    -- Prevent Looting if body is claimed
    if ui.is_claimed then return end

    local grouped = ui.current_grouped
    local total = grouped and #grouped or 0
    if total == 0 then return end

    if flags then
        flags.ret_value = false
    end

    -- dir > 0 is Scroll Up (step = -1); dir <= 0 is Scroll Down (step = 1)
    local step = (dir and dir > 0) and -1 or 1
    local tg   = time_global()

    local key_mod  = hover_corpse_loot_mcm.get_config("key_modifier") or DIK_keys.DIK_LMENU
    local mod_held = hover_corpse_loot_actions and hover_corpse_loot_actions.is_hold_key_active(key_mod) or false
    local swap_ax  = hover_corpse_loot_mcm.get_config("swap_scroll_axis") == true

    -- Verify physical mouse button hold states via `key_state` in case a release event was missed
    local lmb_phys = (lmb_held and (not key_state or key_state(DIK_keys.MOUSE_1) ~= 0))
                     or (hover_corpse_loot_actions and hover_corpse_loot_actions.is_hold_key_active(DIK_keys.MOUSE_1))
    local rmb_phys = (rmb_held and (not key_state or key_state(DIK_keys.MOUSE_2) ~= 0))
                     or (hover_corpse_loot_actions and hover_corpse_loot_actions.is_hold_key_active(DIK_keys.MOUSE_2))

    -- 1. Hold Left Mouse Click + Scroll Wheel -> Bidirectional Sweep-Loot Row
    if ui.selected_idx ~= nil and lmb_phys and not mod_held and hover_corpse_loot_actions then
        lmb_held  = true
        lmb_swept = true -- Arm Sweep Guard so releasing LMB won't loot the post-sweep item!
        block_input_grace_t = tg + 300
        hcl_log(2, "on_mouse_wheel", string.format("LMB+Scroll Sweep-Loot triggered (step=%d, lmb_swept=true)", step))
        hover_corpse_loot_actions.action_row_sweep_take(ui, step)
        return
    end

    -- 2. Hold Right Mouse Click + Scroll Wheel -> Bidirectional Sweep-Disassemble Row (if enabled in MCM)
    if ui.selected_idx ~= nil and rmb_phys and not mod_held and hover_corpse_loot_actions then
        rmb_held  = true
        rmb_swept = true -- Arm Sweep Guard so releasing RMB won't trigger Loot All!
        block_input_grace_t = tg + 350
        if hover_corpse_loot_mcm.get_config("sweep_disassemble") then
            hcl_log(2, "on_mouse_wheel", string.format("RMB+Scroll Sweep-Disassemble triggered (step=%d, rmb_swept=true)", step))
            hover_corpse_loot_actions.action_row_sweep_disassemble(ui, step)
        end
        return
    end

    -- 3. Apply Gesture Cooldown only to standard navigation (if wheel_mode == 2)
    local wheel_mode = hover_corpse_loot_mcm.get_config("wheel_mode") or 1
    if wheel_mode == 2 then
        local cooldown = hover_corpse_loot_mcm.get_config("wheel_cooldown") or 160
        if (tg - last_wheel_time) < cooldown then
            last_wheel_time = tg
            return
        end
    end
    last_wheel_time = tg

    -- 4. Standard 2D Grid Navigation (Normal Scroll vs. Modifier + Scroll)
    local was_nil     = (ui.selected_idx == nil)
    local move_by_col = mod_held
    if swap_ax then
        move_by_col = not mod_held
    end

    if hover_corpse_loot_actions and hover_corpse_loot_actions.navigate_grid then
        hover_corpse_loot_actions.navigate_grid(ui, step, move_by_col)
    else
        ui.selected_idx = ((ui.selected_idx or 0) + step - 1) % total + 1
    end

    local npc = level.object_by_id(ui.target_id)
    if npc then
        if was_nil and ui.selected_idx ~= nil then
            start_hover_fdda_animation(npc)
        end
        ui:UpdateCorpseData(npc, true)
    end
end

---------------------------------------------------------------------------------------
-- Intercepts key/mouse presses BEFORE the engine processes them (`on_before_key_press`).
-- - When `ui.selected_idx == nil`: Does nothing, preserving 100% free weapon aim and fire.
-- - When `ui.selected_idx ~= nil`:
--     * Modifier (`Alt`) + Left Click  -> Field Strip Selected Weapon
--     * Modifier (`Alt`) + Right Click -> Disassemble Selected Item
--     * Unmodified Left Click          -> Suppresses weapon fire and arms `lmb_held`
--                                         (waits for `on_key_release` or Scroll Sweep!)
--     * Unmodified Right Click         -> Suppresses weapon zoom and arms `rmb_held`
--                                         (waits for `on_key_release` or Scroll Sweep!)
-- Arguments: key (number), bind (number), dis (boolean), flags (table)
-- Returns: None
---------------------------------------------------------------------------------------
function on_before_key_press(key, bind, dis, flags)
    local tg = time_global()

    -- Block stray fire/zoom inputs during the grace window after looting/stripping
    if tg < block_input_grace_t and (bind == key_bindings.kWPN_ZOOM or bind == key_bindings.kWPN_FIRE) then
        if flags then flags.ret_value = false end
        return
    end

    if not hover_corpse_loot_mcm.get_config("enabled") then return end
    if not hover_corpse_loot_mcm.get_config("ql_enabled") then return end

    local ui = hover_corpse_loot_ui and hover_corpse_loot_ui.get_ui()
    if not ui or not ui:IsShown() or not ui.selected_idx or ui.is_claimed then
        reset_mouse_hold_states()
        return
    end

    local key_mod  = hover_corpse_loot_mcm.get_config("key_modifier") or DIK_keys.DIK_LMENU
    local mod_held = hover_corpse_loot_actions and hover_corpse_loot_actions.is_hold_key_active(key_mod) or false

    -- 1. Modifier (Default: Left Alt) + Mouse Clicks:
    --    e1: Modifier + Left Click  -> Field Strip Selected Weapon
    --    e2: Modifier + Right Click -> Disassemble Selected Item
    if mod_held and hover_corpse_loot_actions then
        if key == DIK_keys.MOUSE_1 then
            if flags then flags.ret_value = false end
            lmb_held  = false
            lmb_swept = true
            block_input_grace_t = tg + 350
            hcl_log(2, "on_before_key_press", "Modifier + LMB -> Field Strip Selected Weapon")
            hover_corpse_loot_actions.action_field_strip_selected(ui)
            return
        end

        if key == DIK_keys.MOUSE_2 then
            if flags then flags.ret_value = false end
            rmb_held  = false
            rmb_swept = true
            block_input_grace_t = tg + 350
            hcl_log(2, "on_before_key_press", "Modifier + RMB -> Disassemble Selected Item")
            hover_corpse_loot_actions.action_disassemble_selected(ui, false)
            if axr_main and axr_main.weapon_is_zoomed and db.actor then
                level.release_action(key_bindings.kWPN_ZOOM)
            end
            return
        end
    end

    -- 2. Unmodified Left Mouse Click (Hold for Sweep-Loot, or Release to Loot Selected Item):
    --    Suppress weapon fire immediately on press and arm `lmb_held`.
    if key == DIK_keys.MOUSE_1 and not mod_held then
        if flags then flags.ret_value = false end
        lmb_held  = true
        lmb_swept = false
        block_input_grace_t = tg + 250
        return
    end

    -- 3. Unmodified Right Mouse Click (Hold for Sweep-Disassemble, or Release to Loot All):
    --    Suppress weapon ADS/zoom immediately on press and arm `rmb_held`.
    if key == DIK_keys.MOUSE_2 and not mod_held then
        if flags then flags.ret_value = false end
        rmb_held  = true
        rmb_swept = false
        block_input_grace_t = tg + 350
        if axr_main and axr_main.weapon_is_zoomed and db.actor then
            level.release_action(key_bindings.kWPN_ZOOM)
        end
        return
    end
end

---------------------------------------------------------------------------------------
-- Callback fired when a key or mouse button is released (`on_key_release`).
-- Executes single-item looting (`MOUSE_1`) or Loot All (`MOUSE_2`) ONLY on button
-- release, and strictly skips the action if the sweep guard (`lmb_swept` / `rmb_swept`)
-- was triggered while the button was held down!
-- Arguments: key (number), bind (number)
-- Returns: None
---------------------------------------------------------------------------------------
function on_key_release(key, bind)
    local tg = time_global()

    if key == DIK_keys.MOUSE_1 then
        local was_held  = lmb_held
        local was_swept = lmb_swept
        lmb_held  = false
        lmb_swept = false

        if not was_held or was_swept then
            if was_swept then
                block_input_grace_t = tg + 250
                hcl_log(2, "on_key_release", "LMB released after Sweep-Loot; sweep guard prevented extra item loot")
            end
            return
        end

        if not hover_corpse_loot_mcm.get_config("enabled") then return end
        if not hover_corpse_loot_mcm.get_config("ql_enabled") then return end

        local ui = hover_corpse_loot_ui and hover_corpse_loot_ui.get_ui()
        if not ui or not ui:IsShown() or not ui.selected_idx or ui.is_claimed then
            return
        end

        local key_mod  = hover_corpse_loot_mcm.get_config("key_modifier") or DIK_keys.DIK_LMENU
        local mod_held = hover_corpse_loot_actions and hover_corpse_loot_actions.is_hold_key_active(key_mod) or false
        if mod_held then return end

        block_input_grace_t = tg + 250
        hcl_log(2, "on_key_release", "LMB released without sweep -> Looting selected item")
        action_take_selected()
        return
    end

    if key == DIK_keys.MOUSE_2 then
        local was_held  = rmb_held
        local was_swept = rmb_swept
        rmb_held  = false
        rmb_swept = false

        if not was_held or was_swept then
            if was_swept then
                block_input_grace_t = tg + 350
                hcl_log(2, "on_key_release", "RMB released after Sweep-Disassemble; sweep guard prevented Loot All")
            end
            return
        end

        if not hover_corpse_loot_mcm.get_config("enabled") then return end
        if not hover_corpse_loot_mcm.get_config("ql_enabled") then return end

        local ui = hover_corpse_loot_ui and hover_corpse_loot_ui.get_ui()
        if not ui or not ui:IsShown() or not ui.selected_idx or ui.is_claimed then
            return
        end

        local key_mod  = hover_corpse_loot_mcm.get_config("key_modifier") or DIK_keys.DIK_LMENU
        local mod_held = hover_corpse_loot_actions and hover_corpse_loot_actions.is_hold_key_active(key_mod) or false
        if mod_held then return end

        block_input_grace_t = tg + 350
        hcl_log(2, "on_key_release", "RMB released without sweep -> Looting all items")
        action_take_all()
        if axr_main and axr_main.weapon_is_zoomed and db.actor then
            level.release_action(key_bindings.kWPN_ZOOM)
        end
        return
    end
end

---------------------------------------------------------------------------------------
-- Registers mouse wheel, pre-keypress, and key-release callbacks when the game starts.
-- Arguments: None
-- Returns: None
---------------------------------------------------------------------------------------
function on_game_start()
    RegisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
    RegisterScriptCallback("on_before_key_press", on_before_key_press)
    RegisterScriptCallback("on_key_release", on_key_release)
end
